alphabet a b

f_0 = symbol b
f_1 = symbol a
f_2 = rightmost(f_1@j | !true, f_1@j)
f_3 = f_0 & f_2
f_4 = rightmost(f_3@j | !true, f_3@j)
f_5 = f_1 & f_4
f_6 = rightmost(f_5@j | !true, f_5@j)
f_7 = f_0 & f_6
f_8 = rightmost(f_7@j | !true, f_7@j)
f_9 = f_1 & f_8
f_10 = rightmost(f_9@j | !true, f_9@j)
f_11 = f_0 & f_10
f_12 = rightmost(f_11@j | !true, f_11@j)
f_13 = f_1 & f_12
f_14 = rightmost(f_13@j | !true, f_13@j)
f_15 = f_0 & f_14
f_16 = rightmost(f_15@j | !true, f_15@j)
f_17 = f_1 & f_16
f_18 = rightmost(f_17@j | !true, f_17@j)
f_19 = f_0 & f_18
f_20 = !f_19
f_21 = rightmost(f_19@j | !true, f_19@j)
f_22 = !f_21
f_23 = f_20 & f_22
f_24 = !f_23

output f_24