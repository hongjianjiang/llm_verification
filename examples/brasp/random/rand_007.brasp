alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = !is_a & is_c
n1 = rightmost(!n0@j | is_b@j & is_bos@j, is_bos@i | is_a@j & n0@i)
n2 = leftmost(is_c@i & n0@i | !n0@j, is_b@j)
n3 = leftmost(!is_bos@i & is_b@j | !n1@j & is_b@i, n2@j & !is_c@j | n1@i)
accept = n3

output accept
