alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_c@i | !is_c@j & is_bos@j, !is_bos@i)
n1 = is_c & n0 | !is_b & is_bos
n2 = n1
n3 = leftmost(n0@j & is_a@j, n0@i | !n2@j & is_c@j)
n4 = leftmost(n2@j & !is_a@i, !is_bos@i | n0@j & is_b@i)
accept = n4

output accept
