alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_b@i, is_bos@i)
n1 = leftmost(!is_c@j & is_a@j, !is_c@j | is_bos@j)
n2 = rightmost(!n1@i, is_a@i | n0@i & is_bos@j)
n3 = leftmost(!is_b@j & !is_a@i | !is_a@i & is_bos@i, n0@j & n1@i | n1@i & !is_b@i)
accept = n3

output accept
