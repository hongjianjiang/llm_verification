alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_b
n1 = leftmost(is_c@j & is_b@i, !is_bos@i & is_b@j)
n2 = leftmost(!n0@i | !is_c@i, !is_c@i)
n3 = is_c & !is_bos | is_c & !n0
n4 = rightmost(!is_c@i, !n2@i & !is_c@j | is_c@j)
accept = n4 & (!n4 & !is_b | is_b & !is_c)

output accept
