alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_a & is_bos | is_a
n1 = leftmost(is_b@j | is_bos@i & is_a@j, is_b@i)
n2 = rightmost(!is_bos@i & n0@j | !is_bos@j & is_bos@i, is_b@j)
n3 = leftmost(is_bos@j & !is_a@i | is_bos@i & !n2@j, n0@j | n0@i & is_b@j)
n4 = leftmost(is_a@i | !n0@j & is_b@j, !n1@j | is_a@j)
accept = n4 & n0 & !is_b

output accept
