alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = false
n1 = leftmost(n0@j | n0@i, !n0@i & is_bos@j)
n2 = !n1 & !n0 | !is_c & is_b
n3 = rightmost(is_b@j, !is_a@j)
n4 = rightmost(is_a@j | is_c@j, n2@i & n2@j | n1@j & is_b@i)
n5 = rightmost(is_a@i | n4@i, !is_c@j)
accept = n5

output accept
