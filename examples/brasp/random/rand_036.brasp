alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_b@j | is_a@j & is_b@j, is_a@j)
n1 = leftmost(is_bos@j | n0@i & n0@j, is_bos@j | !is_bos@i & !is_a@i)
n2 = is_b | !is_a & is_b
n3 = rightmost(!is_b@i & !is_b@j | !n1@i & is_bos@i, n1@j | n2@j & n0@j)
n4 = is_b & n1
n5 = rightmost(is_b@i, !n4@i & !n3@j | is_b@j & n1@j)
accept = n5

output accept
