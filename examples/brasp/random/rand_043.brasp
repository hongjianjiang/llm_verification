alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(!is_a@i, !is_b@j)
n1 = leftmost(n0@i & is_a@i, is_bos@j | is_bos@i)
n2 = rightmost(is_bos@i, is_b@j & !n1@j | n0@i)
n3 = is_bos
n4 = n2 & !is_bos
n5 = rightmost(n1@i, !is_b@i & !is_a@i | !n1@j)
accept = n5 & (is_bos | !is_a)

output accept
