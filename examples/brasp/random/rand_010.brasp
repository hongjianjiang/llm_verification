alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_bos@j & !is_a@i | !is_b@j, !is_bos@j & !is_c@j)
n1 = leftmost(is_a@j & !is_a@i | !n0@j & !is_c@i, is_c@j | is_c@j & !is_a@j)
n2 = n0 & !is_bos | is_bos & !n0
n3 = rightmost(!is_b@j, is_a@i)
n4 = rightmost(!n2@i & !is_b@j, !n3@i | is_c@j & is_b@i)
accept = n4

output accept
