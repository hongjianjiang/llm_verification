alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_bos@j & !is_a@i | is_a@i & !is_b@i, !is_a@j | is_bos@j & is_b@i)
n1 = rightmost(is_b@i | is_a@i & is_bos@i, !is_a@j & !n0@i | is_bos@i)
n2 = !is_a | !n1
n3 = n2 & is_b | !n1 & is_b
n4 = leftmost(is_a@i, !n0@j & is_a@i | !n1@j & !n1@i)
n5 = rightmost(!n4@i, !is_a@i | is_bos@j & is_b@j)
accept = n5

output accept
