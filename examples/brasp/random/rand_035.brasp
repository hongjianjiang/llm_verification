alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_c & !is_b
n1 = leftmost(is_a@j & is_b@j | is_c@i, !is_c@j & !is_a@j | is_c@i & is_b@i)
n2 = rightmost(!is_b@j, !is_b@j & n1@i | !n1@j & is_a@i)
n3 = leftmost(is_b@i & n0@i | n0@j, is_bos@j & !is_b@i | !n1@i)
accept = n3 & n2

output accept
