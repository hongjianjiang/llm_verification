alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_a@i | is_b@j & !is_a@i, !is_bos@j & is_b@j | !is_a@i & is_c@j)
n1 = rightmost(is_c@j & !is_bos@i | !n0@j, !is_c@i & !is_b@j | !is_bos@i)
n2 = leftmost(n0@i | n1@i, is_bos@j | !n0@j & is_a@j)
n3 = rightmost(is_a@i | n0@i & !n0@j, !is_b@i)
accept = n3

output accept
