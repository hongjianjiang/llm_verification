alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(!is_b@j & is_c@j | is_b@j, is_b@j)
n1 = rightmost(!is_c@i & !is_bos@i | is_b@j, is_bos@j)
n2 = rightmost(!is_c@j | is_c@i, n1@i & n0@i | is_bos@i)
n3 = n0
n4 = leftmost(!is_c@j & n3@j, !is_a@j & n1@i | !n2@j)
accept = n4

output accept
