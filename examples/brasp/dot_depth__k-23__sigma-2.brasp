alphabet a b

f_0 = symbol a
f_1 = symbol b
f_2 = rightmost(f_0@j | !true, f_0@j)
f_3 = f_1 & f_2
f_4 = rightmost(f_3@j | !true, f_3@j)
f_5 = f_0 & f_4
f_6 = rightmost(f_5@j | !true, f_5@j)
f_7 = f_1 & f_6
f_8 = rightmost(f_7@j | !true, f_7@j)
f_9 = f_0 & f_8
f_10 = rightmost(f_9@j | !true, f_9@j)
f_11 = f_1 & f_10
f_12 = rightmost(f_11@j | !true, f_11@j)
f_13 = f_0 & f_12
f_14 = rightmost(f_13@j | !true, f_13@j)
f_15 = f_1 & f_14
f_16 = rightmost(f_15@j | !true, f_15@j)
f_17 = f_0 & f_16
f_18 = rightmost(f_17@j | !true, f_17@j)
f_19 = f_1 & f_18
f_20 = rightmost(f_19@j | !true, f_19@j)
f_21 = f_0 & f_20
f_22 = rightmost(f_21@j | !true, f_21@j)
f_23 = f_1 & f_22
f_24 = rightmost(f_23@j | !true, f_23@j)
f_25 = f_0 & f_24
f_26 = rightmost(f_25@j | !true, f_25@j)
f_27 = f_1 & f_26
f_28 = rightmost(f_27@j | !true, f_27@j)
f_29 = f_0 & f_28
f_30 = rightmost(f_29@j | !true, f_29@j)
f_31 = f_1 & f_30
f_32 = rightmost(f_31@j | !true, f_31@j)
f_33 = f_0 & f_32
f_34 = rightmost(f_33@j | !true, f_33@j)
f_35 = f_1 & f_34
f_36 = rightmost(f_35@j | !true, f_35@j)
f_37 = f_0 & f_36
f_38 = rightmost(f_37@j | !true, f_37@j)
f_39 = f_1 & f_38
f_40 = rightmost(f_39@j | !true, f_39@j)
f_41 = f_0 & f_40
f_42 = rightmost(f_41@j | !true, f_41@j)
f_43 = f_1 & f_42
f_44 = rightmost(f_43@j | !true, f_43@j)
f_45 = f_0 & f_44
f_46 = !f_45
f_47 = rightmost(f_45@j | !true, f_45@j)
f_48 = !f_47
f_49 = f_46 & f_48
f_50 = !f_49

output f_50