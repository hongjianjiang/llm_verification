alphabet a b c d e f g h

is_a = symbol a
is_b = symbol b
is_c = symbol c
is_d = symbol d
is_e = symbol e
is_f = symbol f
is_g = symbol g
is_h = symbol h
seen_a = rightmost(is_a@j, true)
occurs_a = seen_a | is_a
seen_b = rightmost(is_b@j, true)
occurs_b = seen_b | is_b
seen_c = rightmost(is_c@j, true)
occurs_c = seen_c | is_c
seen_d = rightmost(is_d@j, true)
occurs_d = seen_d | is_d
seen_e = rightmost(is_e@j, true)
occurs_e = seen_e | is_e
seen_f = rightmost(is_f@j, true)
occurs_f = seen_f | is_f
seen_g = rightmost(is_g@j, true)
occurs_g = seen_g | is_g
seen_h = rightmost(is_h@j, true)
occurs_h = seen_h | is_h
pair_ab = is_a | is_b
any_ab = rightmost(pair_ab@j, true)
first_ab = leftmost(pair_ab@j, is_a@j)
ok_ab = any_ab & first_ab | !any_ab & is_a
pair_bc = is_b | is_c
any_bc = rightmost(pair_bc@j, true)
first_bc = leftmost(pair_bc@j, is_b@j)
ok_bc = any_bc & first_bc | !any_bc & is_b
pair_cd = is_c | is_d
any_cd = rightmost(pair_cd@j, true)
first_cd = leftmost(pair_cd@j, is_c@j)
ok_cd = any_cd & first_cd | !any_cd & is_c
pair_de = is_d | is_e
any_de = rightmost(pair_de@j, true)
first_de = leftmost(pair_de@j, is_d@j)
ok_de = any_de & first_de | !any_de & is_d
pair_ef = is_e | is_f
any_ef = rightmost(pair_ef@j, true)
first_ef = leftmost(pair_ef@j, is_e@j)
ok_ef = any_ef & first_ef | !any_ef & is_e
pair_fg = is_f | is_g
any_fg = rightmost(pair_fg@j, true)
first_fg = leftmost(pair_fg@j, is_f@j)
ok_fg = any_fg & first_fg | !any_fg & is_f
pair_gh = is_g | is_h
any_gh = rightmost(pair_gh@j, true)
first_gh = leftmost(pair_gh@j, is_g@j)
ok_gh = any_gh & first_gh | !any_gh & is_g
accept = ok_ab & ok_bc & ok_cd & ok_de & ok_ef & ok_fg & ok_gh & occurs_a & occurs_b & occurs_c & occurs_d & occurs_e & occurs_f & occurs_g & occurs_h

output accept
