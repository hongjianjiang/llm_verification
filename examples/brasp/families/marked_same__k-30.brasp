alphabet a b m

is_m = symbol m
is_a = symbol a
is_b = symbol b
prev_a = rightmost(true, is_a@j)
prev_b = rightmost(true, is_b@j)
prev_m = rightmost(true, is_m@j)
h_1 = is_m
p_2 = rightmost(is_m@j, h_1@j)
h_2 = is_m & p_2
p_3 = rightmost(is_m@j, h_2@j)
h_3 = is_m & p_3
p_4 = rightmost(is_m@j, h_3@j)
h_4 = is_m & p_4
p_5 = rightmost(is_m@j, h_4@j)
h_5 = is_m & p_5
p_6 = rightmost(is_m@j, h_5@j)
h_6 = is_m & p_6
p_7 = rightmost(is_m@j, h_6@j)
h_7 = is_m & p_7
p_8 = rightmost(is_m@j, h_7@j)
h_8 = is_m & p_8
p_9 = rightmost(is_m@j, h_8@j)
h_9 = is_m & p_9
p_10 = rightmost(is_m@j, h_9@j)
h_10 = is_m & p_10
p_11 = rightmost(is_m@j, h_10@j)
h_11 = is_m & p_11
p_12 = rightmost(is_m@j, h_11@j)
h_12 = is_m & p_12
p_13 = rightmost(is_m@j, h_12@j)
h_13 = is_m & p_13
p_14 = rightmost(is_m@j, h_13@j)
h_14 = is_m & p_14
p_15 = rightmost(is_m@j, h_14@j)
h_15 = is_m & p_15
p_16 = rightmost(is_m@j, h_15@j)
h_16 = is_m & p_16
p_17 = rightmost(is_m@j, h_16@j)
h_17 = is_m & p_17
p_18 = rightmost(is_m@j, h_17@j)
h_18 = is_m & p_18
p_19 = rightmost(is_m@j, h_18@j)
h_19 = is_m & p_19
p_20 = rightmost(is_m@j, h_19@j)
h_20 = is_m & p_20
p_21 = rightmost(is_m@j, h_20@j)
h_21 = is_m & p_21
p_22 = rightmost(is_m@j, h_21@j)
h_22 = is_m & p_22
p_23 = rightmost(is_m@j, h_22@j)
h_23 = is_m & p_23
p_24 = rightmost(is_m@j, h_23@j)
h_24 = is_m & p_24
p_25 = rightmost(is_m@j, h_24@j)
h_25 = is_m & p_25
p_26 = rightmost(is_m@j, h_25@j)
h_26 = is_m & p_26
p_27 = rightmost(is_m@j, h_26@j)
h_27 = is_m & p_27
p_28 = rightmost(is_m@j, h_27@j)
h_28 = is_m & p_28
p_29 = rightmost(is_m@j, h_28@j)
h_29 = is_m & p_29
p_30 = rightmost(is_m@j, h_29@j)
h_30 = is_m & p_30
accept = rightmost(h_30@j, is_a@i & prev_a@j | is_b@i & prev_b@j | is_m@i & prev_m@j)

output accept
