f_4_since = rightmost(!!(((((!(f_0@i & f_1@j) & !(f_2@i & f_1@j)) & !(f_2@i & f_0@j)) & !(f_3@i & f_1@j)) & !(f_3@i & f_0@j)) & !(f_3@i & f_2@j)) | !true, !!(((((!(f_0@i & f_1@j) & !(f_2@i & f_1@j)) & !(f_2@i & f_0@j)) & !(f_3@i & f_1@j)) & !(f_3@i & f_0@j)) & !(f_3@i & f_2@j)))
f_4 = !f_4_since

output f_4