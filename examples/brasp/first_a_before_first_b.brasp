# uhat task `first_a_before_first_b`: both symbols occur, and the first `a`
# comes before the first `b` -- equivalently, the word's first symbol is `a`
# and a `b` occurs somewhere.
alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
seen_symbol = rightmost(!is_bos@j, true)
at_first = !is_bos & !seen_symbol
first_is_a = at_first & is_a
saw_first_a = rightmost(first_is_a@j, true)
starts_a = first_is_a | saw_first_a
saw_b = rightmost(is_b@j, true)
has_b = is_b | saw_b
accept = starts_a & has_b

output accept
