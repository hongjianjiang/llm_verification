alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_c@j, is_c@i & is_b@i & !is_a@j)
n1 = leftmost(is_b@j, !is_b@i & is_c@j | n0@j)
n2 = rightmost(!n1@i, !is_c@i & n0@j | n1@j & !is_a@i)
n3 = leftmost(n0@i & !is_b@j | is_a@j & is_bos@j, !n1@j)
accept = n3

output accept
