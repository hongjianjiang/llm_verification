alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_b | is_a & is_bos
n1 = rightmost(n0@i | is_a@i, n0@i & is_a@j | is_a@i & !n0@j)
n2 = leftmost(!n1@i & !is_bos@j | is_bos@j & !is_bos@i, is_a@j & !n0@i)
n3 = leftmost(n1@j & !is_bos@j, !is_bos@j & n0@j)
n4 = rightmost(is_a@j & n0@j | !n2@j, !n3@j | n0@i & n0@j)
accept = n4

output accept
