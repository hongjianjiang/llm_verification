alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_c@i & !is_c@j | is_c@j, is_bos@i & is_bos@j)
n1 = is_bos
n2 = leftmost(!is_b@i & n1@j, !n1@i & is_b@i & n1@j)
n3 = rightmost(is_bos@i & !is_c@i | is_c@j & n0@j, is_a@i & is_a@j | !is_bos@i & is_a@j)
accept = n3

output accept
