alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_b@i & is_a@j | is_bos@j, is_a@i & is_bos@j | !is_a@j)
n1 = is_bos
n2 = leftmost(is_c@j & n0@i, !n1@j)
n3 = n2 & !is_a | is_bos
n4 = leftmost(!n0@i & is_c@i | n0@j & is_b@i, is_bos@i & is_bos@j | n2@i & is_a@j)
accept = n4

output accept
