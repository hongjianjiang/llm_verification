alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_c@i | is_b@j, !is_b@j & is_bos@j | is_b@j & !is_a@i)
n1 = leftmost(n0@i & is_bos@j | is_b@i & is_bos@i, !is_c@i & is_bos@i & !is_a@j | n0@i & is_c@j)
n2 = is_bos
n3 = !is_b | !n0
n4 = rightmost(!is_b@i & !is_c@i, !is_c@i & !n0@j | !is_b@j)
accept = n4 & (n0 | n4)

output accept
