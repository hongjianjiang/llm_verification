alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_b@i | is_bos@j, !is_a@j & !is_b@i | is_c@j)
n1 = leftmost(!is_b@i & !is_a@i, n0@i & !is_a@i & is_b@j)
n2 = leftmost(!is_c@i | n1@i, !n1@j & !is_bos@i | is_bos@i & !is_c@j)
n3 = rightmost(n2@i | !is_c@j, is_bos@j | is_a@j & !n1@i)
accept = n3

output accept
