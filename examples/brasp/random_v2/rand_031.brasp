alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_c
n1 = leftmost(!is_a@i & n0@j, is_c@i & is_a@j)
n2 = rightmost(!is_c@j & is_bos@j | !is_c@i & !is_bos@j, !is_bos@i & is_bos@j | is_a@i & is_bos@i & n0@j)
n3 = leftmost(!is_a@i, !n2@j | is_bos@j)
n4 = leftmost(!n0@i & !is_a@j | n3@i & !n3@j, n3@j)
n5 = rightmost(n2@i | n2@j, is_b@j)
accept = n5 & (!n2 | n5)

output accept
