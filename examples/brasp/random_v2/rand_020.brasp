alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_b@j | is_b@j & !is_bos@j, !is_c@i & is_bos@j)
n1 = leftmost(!is_a@j, is_c@i & is_b@j | !is_bos@j)
n2 = leftmost(!is_c@i & !is_b@i, is_c@j)
n3 = rightmost(is_c@j | !is_c@j & !n1@i, n2@i & n1@j | !is_a@j)
accept = n3

output accept
