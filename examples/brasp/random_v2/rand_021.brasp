alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(!is_bos@i & is_c@j, !is_c@i & !is_b@i & is_b@j | !is_bos@i & is_c@i & !is_b@j)
n1 = rightmost(!n0@i & !n0@j | is_bos@j & is_b@j, !n0@j & is_b@j | is_a@i & is_c@j)
n2 = leftmost(!n0@i | !n0@j & !is_bos@i, is_b@i & is_bos@j)
n3 = rightmost(n1@i & !is_c@i, is_c@j)
accept = n3

output accept
