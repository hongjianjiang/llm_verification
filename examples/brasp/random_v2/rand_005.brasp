alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_a
n1 = leftmost(is_bos@j, is_bos@i & is_a@j | is_b@i & is_c@j)
n2 = rightmost(n1@j | n0@j, !n1@j & n1@i | n0@i & is_c@j)
n3 = rightmost(is_b@j, n1@i & !is_c@i & is_a@j | n1@i & !is_bos@i & !n1@j)
n4 = rightmost(is_bos@i & is_a@j | n0@j, !is_bos@i & !is_c@j | !n1@j & !n3@i)
n5 = rightmost(n4@j, n4@j & is_b@j | n1@i & is_c@j)
accept = n5

output accept
