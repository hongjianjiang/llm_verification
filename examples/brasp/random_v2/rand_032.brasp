alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_c@j, !is_b@i & !is_a@i & is_b@j | is_a@i & is_b@j)
n1 = leftmost(!is_bos@i & !n0@i, is_c@i & n0@j)
n2 = rightmost(is_bos@i & !is_a@j, !is_c@j & !is_bos@j | n1@i & !n0@j)
accept = n2 & (n0 | is_b)

output accept
