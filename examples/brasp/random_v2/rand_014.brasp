alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = !is_a | !is_b & is_bos
n1 = leftmost(is_b@j | is_b@i & n0@i, is_b@i & is_a@i & !n0@j)
n2 = leftmost(is_bos@i & n0@j, !is_a@j & !n1@i | n1@i & is_b@i & is_a@j)
n3 = !n1 & !is_b
n4 = leftmost(!is_a@i & is_b@j | !is_a@j, n3@j & is_bos@i | n2@i & !is_bos@j)
n5 = rightmost(!is_a@j & !n4@i | is_b@i & !n0@j, !n3@j | n2@i & !is_a@j)
accept = n5

output accept
