alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_a@j & is_bos@i, is_b@j & is_bos@j)
n1 = !is_bos & !is_b | n0
n2 = leftmost(is_a@i & n0@i, !is_a@i & is_a@j)
n3 = leftmost(!is_b@j | is_a@i & is_b@i, is_a@j)
n4 = n3 | !n3
n5 = leftmost(false, n2@i & !n0@i & n0@j | n4@j & n3@j)
accept = n5 & (is_bos | !n0)

output accept
