alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = !is_bos | is_bos & is_b
n1 = rightmost(is_c@i, !is_a@i & n0@i & is_c@j)
n2 = leftmost(!is_a@j & !is_bos@i | is_c@j & n1@j, n1@j | is_c@i & is_bos@i & !is_c@j)
n3 = rightmost(!is_bos@i, !is_bos@j & !n2@j | is_a@j)
n4 = rightmost(n3@i, is_c@j & n3@j | is_bos@j & n2@j)
accept = n4 & n1

output accept
