alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_a@i & is_b@j | is_c@i & is_c@j, is_b@i & is_bos@j | is_c@j)
n1 = !is_a & !n0 | !n0
n2 = rightmost(!n0@i, !is_c@i & !n0@j | !is_a@j & n0@j)
n3 = leftmost(is_c@i & !n1@i, is_bos@i & !is_b@j)
n4 = rightmost(!is_a@i, !n1@j | is_a@i & !is_c@j)
accept = n4

output accept
