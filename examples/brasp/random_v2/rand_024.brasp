alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_a | is_bos
n1 = rightmost(!is_bos@j | !is_b@j & is_c@j, !is_b@j & !is_b@i)
n2 = rightmost(!is_c@i & is_c@j, !is_c@j & is_a@j | is_c@j)
n3 = !n2
n4 = leftmost(n1@j & is_a@i | is_bos@i, n0@j | !is_c@j & !is_a@j)
accept = n4

output accept
