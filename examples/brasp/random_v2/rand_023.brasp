alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_b@i & !is_a@i | !is_bos@j, !is_b@i & is_b@j)
n1 = rightmost(is_bos@i | is_bos@j & is_a@j, !is_a@i & n0@j | !n0@i & !is_a@j)
n2 = leftmost(!n0@j, !n0@i & !n0@j)
n3 = is_b
n4 = leftmost(n0@j & !is_b@j, n2@j | !is_b@j)
accept = n4

output accept
