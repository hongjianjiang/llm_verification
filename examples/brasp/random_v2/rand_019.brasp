alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_b | is_a
n1 = leftmost(is_c@i | !is_b@i & is_b@j, is_bos@i & !is_c@i & !is_a@j | is_c@i & is_a@i & !is_bos@j)
n2 = rightmost(!n0@i | !is_c@i, !n1@j & is_b@i | !is_a@j & is_c@j)
n3 = is_bos
n4 = leftmost(n2@j, is_a@i & !n1@j | !is_c@j)
n5 = rightmost(!n3@j | is_b@i, is_c@i & is_b@j | n1@j)
n6 = leftmost(n3@i | is_c@j, n0@i & n0@j | !is_c@i & n2@i & !n5@j)
accept = n6

output accept
