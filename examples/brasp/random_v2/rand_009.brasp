alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_bos
n1 = rightmost(is_b@i & n0@j | !is_a@i & !is_a@j, is_b@i & is_b@j | is_b@i & n0@j)
n2 = rightmost(n0@j & !is_a@i, is_a@j)
n3 = rightmost(is_bos@j | is_b@j & !n0@i, is_a@i & is_bos@i & !n2@j | !is_bos@i & is_bos@j)
n4 = rightmost(is_b@i & !is_bos@i | is_bos@i, n1@i & n1@j | is_a@j)
n5 = !n2 | n3
n6 = rightmost(!is_a@j | !n5@i & !n0@j, n1@i & n4@j | !n1@j)
accept = n6

output accept
