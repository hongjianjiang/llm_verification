alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_bos@j | is_bos@i & is_a@i, false)
n1 = rightmost(n0@i | !is_bos@i, is_bos@j)
n2 = n1 | !is_bos & is_a
n3 = rightmost(!is_a@j, n0@i & is_bos@j)
n4 = rightmost(n3@j | is_b@i & n1@j, n1@i & n0@j)
accept = n4 & (n1 | is_bos & n1)

output accept
