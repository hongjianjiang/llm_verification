alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(is_a@i, !is_bos@i & is_a@i & is_b@j)
n1 = leftmost(is_a@j & !n0@i, !n0@i & !is_bos@j | is_b@j & !n0@j)
n2 = rightmost(!is_a@j & n0@i | !n1@i & is_a@i, !n0@j | is_a@j & !n0@i)
n3 = leftmost(!n2@i & !is_bos@j | is_b@j, is_b@j | !is_bos@j)
accept = n3 & (n3 & !n1 | is_bos)

output accept
