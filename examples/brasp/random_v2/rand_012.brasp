alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_b
n1 = leftmost(!is_b@i & !is_a@i | !is_b@j, !n0@j & !is_b@i | !is_bos@i & !is_a@j)
n2 = !is_b
n3 = rightmost(is_bos@j & !is_b@j | !is_b@j, n0@i & is_bos@j | !is_a@i & !n1@j)
n4 = rightmost(n0@j & !n2@i | !is_b@i, is_b@j | n3@j)
accept = n4

output accept
