alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_b
n1 = rightmost(is_bos@i, is_b@i & is_bos@j | is_a@j & !is_c@j)
n2 = rightmost(is_b@j & n0@j, !is_a@i & n1@j | !is_a@i & n0@j)
n3 = rightmost(n2@j, is_c@j)
n4 = !is_b | !n3 & !n2
n5 = rightmost(!is_a@j, n4@j & !n3@j | !is_bos@j & !n4@j)
accept = n5

output accept
