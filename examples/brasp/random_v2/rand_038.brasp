alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_b & is_bos
n1 = leftmost(is_b@i & is_bos@i, !n0@i & is_a@i & !is_bos@j | is_bos@j)
n2 = rightmost(!is_bos@j, n0@j & is_b@j)
n3 = is_bos & is_b | !is_bos
n4 = rightmost(!n3@j & !is_bos@i, is_bos@j & is_bos@i)
accept = n4

output accept
