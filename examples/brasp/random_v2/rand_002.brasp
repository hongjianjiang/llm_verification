alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_a | !is_c
n1 = rightmost(!is_c@i & n0@i, !is_bos@i & is_c@j)
n2 = leftmost(!n0@i & is_b@i | !is_c@i & n1@j, n1@i & !is_b@i & n1@j)
n3 = is_a
n4 = rightmost(!is_bos@j | is_a@j, n3@j | !n3@i & !is_c@j)
n5 = rightmost(is_b@j & !n2@i, n1@j)
accept = n5

output accept
