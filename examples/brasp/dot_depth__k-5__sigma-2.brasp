alphabet a b

f_0 = symbol a
f_1 = symbol b
f_2 = rightmost(f_0@j | !true, f_0@j)
f_3 = f_1 & f_2
f_4 = rightmost(f_3@j | !true, f_3@j)
f_5 = f_0 & f_4
f_6 = rightmost(f_5@j | !true, f_5@j)
f_7 = f_1 & f_6
f_8 = rightmost(f_7@j | !true, f_7@j)
f_9 = f_0 & f_8
f_10 = !f_9
f_11 = rightmost(f_9@j | !true, f_9@j)
f_12 = !f_11
f_13 = f_10 & f_12
f_14 = !f_13

output f_14