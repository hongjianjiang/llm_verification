alphabet a b c d

f_0 = symbol b
f_1 = symbol a
f_2 = symbol d
f_3 = symbol c
f_4 = rightmost(f_1@j | !true, f_1@j)
f_5 = f_0 & f_4
f_6 = rightmost(f_5@j | !true, f_5@j)
f_7 = f_3 & f_6
f_8 = rightmost(f_7@j | !true, f_7@j)
f_9 = f_2 & f_8
f_10 = rightmost(f_9@j | !true, f_9@j)
f_11 = f_1 & f_10
f_12 = rightmost(f_11@j | !true, f_11@j)
f_13 = f_0 & f_12
f_14 = !f_13
f_15 = rightmost(f_13@j | !true, f_13@j)
f_16 = !f_15
f_17 = f_14 & f_16
f_18 = !f_17

output f_18