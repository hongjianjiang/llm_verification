alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(!is_a@j & is_a@i | is_a@j & is_b@i, !is_a@i & is_a@j)
n1 = leftmost(!is_a@j & !n0@i | is_bos@i & is_bos@j, is_bos@j | !n0@j)
n2 = rightmost(!n1@i, is_a@j | !n0@j & is_a@j)
n3 = leftmost(is_bos@i & is_b@i | is_a@i, !n0@j)
n4 = rightmost(!n2@i, is_b@j)
n5 = !is_a & n1
n6 = rightmost(!n5@j, n5@j | n5@j & !n0@j)
n7 = rightmost(!n2@j & n0@j | !n2@j, n2@i & is_bos@j | !n0@j)
n8 = rightmost(!n2@j, !n7@j & !n1@j)
accept = n8

output accept
