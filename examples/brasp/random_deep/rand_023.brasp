alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_b | !is_a & !is_bos
n1 = rightmost(n0@i & !n0@j, n0@i & !is_b@i & is_b@j)
n2 = is_bos & !is_b
n3 = rightmost(n0@i & !n2@j | n1@i, n0@j & !is_bos@i)
n4 = leftmost(!n3@i & n3@j, is_a@i & n0@j | n2@j)
n5 = leftmost(!n1@i & !n4@i | !n4@i & !is_a@i, is_bos@i & n4@j | !is_b@j)
n6 = rightmost(is_a@i & is_b@j | n2@i & is_bos@j, is_a@i & n3@j)
n7 = rightmost(!n3@j, !n5@j | n2@i & n1@i & n2@j)
accept = n7 & (!n2 & n3 | !n2)

output accept
