alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(!is_a@i | is_a@i & !is_b@i, !is_bos@j | !is_bos@i & is_b@j)
n1 = leftmost(n0@j & !is_a@i, is_a@j | is_bos@j & is_b@j)
n2 = leftmost(!n0@i | n1@i, !is_bos@j & !is_a@i)
n3 = leftmost(n1@i & n0@i | !is_b@i & is_b@j, !is_b@j | !is_a@j & !is_b@i)
n4 = rightmost(!is_a@j | n1@i & n0@j, n2@j)
n5 = rightmost(is_bos@i | !n2@i & n1@i, !n4@j)
n6 = n1 & is_b | !n4 & n0
n7 = leftmost(n0@j & n5@j | n2@j, n3@j)
n8 = leftmost(!n2@j & !n4@j, n0@i & n3@j | !n3@i & !n1@j)
accept = n8 & !n3

output accept
