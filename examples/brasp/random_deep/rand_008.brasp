alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(!is_c@i, !is_bos@j | !is_b@i & !is_b@j)
n1 = rightmost(is_bos@j & !is_b@i | is_c@i & is_bos@i, !is_c@j | !n0@i & is_c@j)
n2 = leftmost(is_c@j | !n0@j, !n1@i & is_bos@j | !is_c@j)
n3 = rightmost(!n0@j & is_b@j, !n1@j & !is_c@i)
n4 = leftmost(!is_c@i & !n0@i | is_c@i, !is_b@j | n2@j)
n5 = rightmost(n1@j & !n3@i, n1@j & !is_c@j | is_a@i & is_bos@j)
n6 = rightmost(n4@i & n3@j, false)
n7 = leftmost(!is_bos@i, !is_a@j & n2@i | is_b@i & n4@j)
n8 = leftmost(!n1@j, is_bos@j | n2@j & !n0@j)
n9 = n2 | n1
n10 = leftmost(is_c@j & n0@i | n4@i & is_c@i, !n0@j & n5@i)
accept = n10

output accept
