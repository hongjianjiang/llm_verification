alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(!is_c@i & !is_a@j, !is_bos@j | is_bos@j & is_c@i)
n1 = leftmost(is_bos@j | !is_bos@i, n0@i & is_b@j | !is_c@j)
n2 = rightmost(n0@j & n1@i | !is_b@i & n1@j, !is_c@i & is_b@j)
n3 = rightmost(false, !is_bos@i & is_c@j | !n0@j & !is_c@i)
n4 = rightmost(!is_c@j, is_a@j | is_c@j & is_bos@i)
n5 = rightmost(!is_c@i, !n3@j)
n6 = leftmost(!n5@j | n2@j & n5@j, n0@i & !n3@j | !n5@i & n4@j)
n7 = leftmost(!n1@i & !is_c@i | !is_bos@j & !n0@i, !n6@i & is_c@j | !n3@j)
accept = n7 & (!n4 | n3)

output accept
