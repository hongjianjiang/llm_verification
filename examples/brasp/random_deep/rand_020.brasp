alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_b@j & is_bos@j | is_bos@j, is_bos@i & is_b@i & is_bos@j)
n1 = leftmost(!n0@i | n0@i, !is_bos@i & is_a@j | !is_b@i & !is_b@j)
n2 = rightmost(is_bos@j | !n0@i & n1@j, !is_a@j & !is_b@i)
n3 = rightmost(!is_bos@i & !is_b@i, is_a@i & is_b@i & n1@j | n1@i & n1@j)
n4 = rightmost(!n3@j & is_b@j | n3@j & !n1@i, is_b@j | !n2@i & n3@j)
n5 = is_bos & n1
n6 = leftmost(!n0@j & n5@j | is_a@j & !n1@i, n1@j | !n0@j & !n4@j)
n7 = leftmost(n6@j | !n0@j & is_b@j, is_a@i & n1@i & n0@j | !n6@i & n3@j)
n8 = leftmost(!n0@i, n3@j)
n9 = leftmost(n2@i & is_b@j | !is_b@j & is_b@i, !n5@i & !n5@j | !n1@i & is_bos@i & n6@j)
accept = n9

output accept
