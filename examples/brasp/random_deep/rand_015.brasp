alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_b@j & is_c@i | is_c@j & !is_a@i, !is_c@j & is_b@j | is_c@j & is_bos@j)
n1 = leftmost(!n0@j & is_a@i, is_bos@i & !n0@j)
n2 = rightmost(!is_a@i, !is_b@i & is_c@i & n0@j | is_a@i & n1@i & n1@j)
n3 = rightmost(!n1@i | is_c@i, n2@j)
n4 = leftmost(!is_bos@j, !is_b@j)
n5 = rightmost(is_b@i, !n3@i & is_c@j)
n6 = is_a & !n5
n7 = is_c
n8 = rightmost(!is_a@i, !n6@i & n5@j)
accept = n8

output accept
