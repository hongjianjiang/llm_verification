alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_a@j & is_c@i | is_a@i & is_a@j, !is_b@j & !is_b@i | is_a@i & !is_a@j)
n1 = rightmost(n0@j & !is_a@i | n0@j, is_a@j | is_a@i & !n0@j)
n2 = rightmost(is_bos@j & n0@j, !is_b@j & is_a@j)
n3 = rightmost(!is_c@j, !is_c@i & !n2@j)
n4 = leftmost(is_bos@j | is_bos@i, !n0@i & !is_a@j | n1@j & n3@j)
n5 = rightmost(is_b@j | n1@j, !n1@j & is_bos@j)
n6 = rightmost(n1@i & !n3@j, !is_c@i & !n3@j | is_a@i & n3@j)
n7 = leftmost(!n4@j, n0@j & !n5@i | !is_a@i & n1@i & !n6@j)
accept = n7 & (n1 & !n2 | n5 & !n3)

output accept
