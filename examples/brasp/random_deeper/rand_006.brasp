alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_b@i & is_b@j, is_bos@j & !is_a@i)
n1 = rightmost(!is_bos@i | n0@i, !is_bos@j)
n2 = rightmost(n1@i & n0@i | n1@j, n0@j)
n3 = leftmost(is_b@j | !n2@j, is_a@i & is_b@j | is_b@i & is_a@j)
n4 = rightmost(n1@i & n0@i, is_a@i & !is_bos@j)
n5 = leftmost(!is_b@i | is_b@j, n1@j)
n6 = rightmost(n1@j | is_b@j & n3@i, n0@j & n3@j | !n1@i & n0@j)
n7 = rightmost(is_bos@j, !n4@i & !n5@j | !is_bos@i & is_a@j)
n8 = leftmost(is_a@i | n4@i & is_a@j, !is_bos@j & !is_bos@i | !n3@j & n5@j)
n9 = leftmost(!n7@j, n1@j | is_a@j & is_b@i)
n10 = rightmost(is_bos@j | n5@i & n8@i, !n1@i & n6@j | n6@j & n8@i)
n11 = leftmost(n0@i | !n5@i & !is_b@j, !is_b@i & !n4@i & n3@j | is_a@j & n10@j)
n12 = leftmost(n0@i | n0@i & is_b@i, is_b@j & n7@j)
n13 = rightmost(!n1@i | n5@i, !n5@j)
n14 = rightmost(n2@i & !n11@i | !is_b@j & is_a@j, n13@i & !is_a@i & n6@j)
n15 = leftmost(is_bos@j | !is_b@i, n13@j)
n16 = leftmost(n10@j | is_bos@j, !n3@j & n2@i)
n17 = leftmost(n10@i & !n8@j | !n1@i & !n13@i, !is_a@j & n11@j)
n18 = rightmost(!is_a@i | n7@j, n14@i & n2@j | !n14@i & n13@j)
accept = n18

output accept
