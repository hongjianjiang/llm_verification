alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_b@i, is_b@i & is_bos@j)
n1 = rightmost(n0@i & is_bos@i | n0@i, is_a@i & is_a@j | n0@i & is_bos@j)
n2 = leftmost(n0@j, !n1@j & is_b@i)
n3 = leftmost(n0@j, !n2@j & !is_bos@j)
n4 = rightmost(!n3@j & !is_b@j | is_a@i, n1@j)
n5 = leftmost(n2@i, !n4@j | !n4@j & n1@j)
n6 = leftmost(is_b@j, is_bos@j & !is_bos@i)
n7 = leftmost(n0@i, !n0@i & n5@j)
n8 = rightmost(n7@i | is_a@i & !n4@j, !is_b@j & n6@i | !n7@j)
n9 = leftmost(n3@i & !is_a@i, n5@i & n0@j)
n10 = leftmost(n1@i, !n8@i & n3@j)
n11 = leftmost(is_b@i & n10@i, !n3@j & !is_bos@j)
n12 = leftmost(!n6@j | !n3@i & is_bos@i, is_bos@j & !is_a@i)
n13 = leftmost(!n2@j & n1@i | n10@j & is_a@j, n3@i & n12@j | !n1@j & !n10@j)
n14 = rightmost(!is_bos@j | n0@i & !n11@i, !n5@j)
n15 = rightmost(!n10@i, is_b@i & n14@j | is_bos@i & !n4@i & n1@j)
accept = n15

output accept
