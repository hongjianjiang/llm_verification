alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_a@j | !is_a@i, is_bos@j & is_a@i)
n1 = leftmost(!is_bos@j, is_bos@j | !is_b@j)
n2 = rightmost(is_b@j | !is_b@i & is_a@i, !is_b@i & n1@j | !n1@j)
n3 = leftmost(n0@j & !is_a@j, n1@i & !is_bos@j)
n4 = leftmost(n2@j, n0@j & !n1@i)
n5 = rightmost(n2@i & !is_bos@i, n2@j)
n6 = rightmost(!n3@j & !n0@j, !n5@i & n1@j)
n7 = leftmost(n2@i & n5@i | n4@j, n1@i & !n0@i & !n2@j | n4@i & !n6@j)
n8 = leftmost(!is_a@j & n6@j | !n4@j & !n2@i, n7@j)
n9 = leftmost(is_b@j & n6@j | n4@i & !n1@i, n8@j & n6@i)
n10 = leftmost(!n6@j & n0@i, n5@j & !is_bos@j | n0@i & is_bos@j)
n11 = leftmost(!n9@j, n10@i & n9@j)
n12 = leftmost(!n5@i | n11@i & !n10@i, !is_bos@j | !n7@i & n8@i & !n1@j)
n13 = leftmost(n1@i | n4@j, !n2@i & !n2@j | !is_a@j & !n3@i)
n14 = rightmost(!n1@i & !n2@i | is_b@i & n4@i, n7@i & n11@i & !n0@j)
n15 = rightmost(is_a@i & is_b@j, n4@j & n9@j)
n16 = leftmost(!n12@j & !n14@i | !n5@j & !n3@i, !n8@j)
n17 = rightmost(n9@i | n16@j & !n15@i, !n1@i & !is_a@j)
accept = n17

output accept
