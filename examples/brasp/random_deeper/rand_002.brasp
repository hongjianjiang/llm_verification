alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(!is_a@i & is_c@i, is_bos@j & !is_b@i | !is_b@j & !is_bos@i)
n1 = leftmost(is_bos@i | !is_c@j, n0@j | is_b@i & is_b@j)
n2 = rightmost(!is_bos@i & !is_b@i | !is_bos@j & !is_b@j, !n0@i & n0@j | n1@j)
n3 = leftmost(is_bos@j & is_a@j | !n1@j, n1@i & n2@j | !n1@j)
n4 = rightmost(!is_a@j & !n3@i | !is_a@i, !n2@j | !is_a@i & is_c@j)
n5 = rightmost(!is_a@i & !n1@i | n4@i, n0@j)
n6 = leftmost(n1@j | n4@j, n3@i & n2@j)
n7 = rightmost(is_b@i | !is_bos@j, !is_c@j & !is_a@i | n5@j)
n8 = leftmost(!n2@j | is_b@j & is_a@j, n5@j)
n9 = leftmost(!n0@j & n7@j, !n5@j & n5@i | n5@i & n3@j)
n10 = rightmost(n1@i & !is_c@i | is_b@i & is_bos@j, !n9@i & n7@j | n1@j)
n11 = leftmost(!n4@j | n5@i & !is_bos@i, n4@j & n8@j | n3@j & is_c@j)
n12 = n4
n13 = rightmost(!is_b@i | n9@i & n2@j, n7@j)
n14 = leftmost(!n10@j, is_bos@i & !n10@j | n13@i & n1@i & is_b@j)
n15 = leftmost(!n6@i | !n9@i, n10@i & n4@i & n8@j)
n16 = leftmost(n9@j, !n6@j & n5@j)
n17 = leftmost(!n1@i & !n16@i, !n12@j)
n18 = is_b & n15 | n0 & is_b
n19 = leftmost(!n2@j & !n18@i | n14@i & n15@j, n4@i & !is_b@j)
accept = n19

output accept
