alphabet a b

f_0 = symbol a
f_1 = symbol b
f_2 = rightmost(f_0@j | !true, f_0@j)
f_3 = f_1 & f_2
f_4 = rightmost(f_3@j | !true, f_3@j)
f_5 = f_0 & f_4
f_6 = rightmost(f_5@j | !true, f_5@j)
f_7 = f_1 & f_6
f_8 = rightmost(f_7@j | !true, f_7@j)
f_9 = f_0 & f_8
f_10 = rightmost(f_9@j | !true, f_9@j)
f_11 = f_1 & f_10
f_12 = rightmost(f_11@j | !true, f_11@j)
f_13 = f_0 & f_12
f_14 = rightmost(f_13@j | !true, f_13@j)
f_15 = f_1 & f_14
f_16 = rightmost(f_15@j | !true, f_15@j)
f_17 = f_0 & f_16
f_18 = rightmost(f_17@j | !true, f_17@j)
f_19 = f_1 & f_18
f_20 = rightmost(f_19@j | !true, f_19@j)
f_21 = f_0 & f_20
f_22 = rightmost(f_21@j | !true, f_21@j)
f_23 = f_1 & f_22
f_24 = rightmost(f_23@j | !true, f_23@j)
f_25 = f_0 & f_24
f_26 = rightmost(f_25@j | !true, f_25@j)
f_27 = f_1 & f_26
f_28 = rightmost(f_27@j | !true, f_27@j)
f_29 = f_0 & f_28
f_30 = !f_29
f_31 = rightmost(f_29@j | !true, f_29@j)
f_32 = !f_31
f_33 = f_30 & f_32
f_34 = !f_33

output f_34