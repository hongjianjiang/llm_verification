alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_b & !is_c | is_bos
n1 = leftmost(!is_c@i | !is_bos@j & !is_c@j, !is_c@i & !is_b@j | is_b@j & !is_bos@i)
n2 = leftmost(!is_c@j & is_bos@i, is_a@i & !is_bos@j)
n3 = leftmost(!is_c@i, is_c@i & is_bos@j | n1@i & is_bos@j)
n4 = leftmost(n3@j, !is_a@i & n0@j | is_a@j & is_bos@j)
accept = n4

output accept
