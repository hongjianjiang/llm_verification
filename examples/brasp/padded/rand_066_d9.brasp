alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_b@j | is_b@i, !is_a@i & is_a@j)
n1 = is_a | is_c & !is_bos
n2 = leftmost(!is_b@j, !n1@i & is_b@j | n0@i & n0@j)
n3 = leftmost(!n0@j, is_bos@i & n0@j)
n4 = rightmost(!is_b@j, false)
n5 = rightmost(n1@j | !n1@j, !n1@j & !is_c@j | !n2@i & !n0@j)
accept = n5
pad_1 = rightmost(is_bos@j, accept@i)
pad_2 = rightmost(is_bos@j, pad_1@i)
pad_3 = rightmost(is_bos@j, pad_2@i)
pad_4 = rightmost(is_bos@j, pad_3@i)
pad_5 = rightmost(is_bos@j, pad_4@i)
pad_6 = rightmost(is_bos@j, pad_5@i)

output pad_6
