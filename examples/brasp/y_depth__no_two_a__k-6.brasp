alphabet a b

f_0 = symbol a
f_1 = rightmost(f_0@j | !false, f_0@j)
f_2 = rightmost(f_1@j | !false, f_1@j)
f_3 = rightmost(f_2@j | !false, f_2@j)
f_4 = rightmost(f_3@j | !false, f_3@j)
f_5 = rightmost(f_4@j | !false, f_4@j)
f_6 = rightmost(f_5@j | !false, f_5@j)
f_7 = f_0 & f_6
f_8 = !f_7
f_9_since = rightmost(!f_8@j | !true, !f_8@j)
f_9 = !f_9_since

output f_9