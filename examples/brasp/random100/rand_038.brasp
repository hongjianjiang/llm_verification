alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_a@i & is_c@j | !is_a@i & is_b@j, is_c@i & is_b@j)
n1 = rightmost(is_bos@i & !is_c@j | is_c@j & !is_a@i, is_c@j & !n0@i)
n2 = leftmost(is_c@j & n0@j, n0@i & is_bos@j | !n1@j & !is_bos@j)
n3 = rightmost(!is_c@i | n2@j, is_c@i & is_b@i & !n1@j | !is_c@j)
n4 = rightmost(!n2@j & !n0@j | !is_c@i, !n0@i & !is_a@i & !is_c@j)
accept = n4 & !n3

output accept
