alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_b@j | is_bos@j & !is_bos@i, !is_b@j & is_c@j)
n1 = !is_a & is_bos | is_a & is_bos
n2 = !is_bos & !is_c
n3 = rightmost(!is_b@i & !n0@j, is_c@i & is_a@j)
n4 = leftmost(!is_a@i & is_b@j | is_c@j & is_a@j, !n0@j & n2@j)
accept = n4

output accept
