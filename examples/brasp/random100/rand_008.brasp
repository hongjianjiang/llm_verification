alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(!is_b@i, is_a@j | is_b@i & !is_b@j)
n1 = !is_b
n2 = rightmost(n0@j & is_bos@j, n0@i & !is_bos@j | !is_a@j)
n3 = n1 & is_bos
n4 = leftmost(!is_a@i & is_b@j | is_a@j & n2@j, n0@j & !is_bos@i | n0@j)
n5 = leftmost(is_a@j | n0@i & !n2@i, !is_a@j & n1@j | is_b@i & !n4@j)
accept = n5

output accept
