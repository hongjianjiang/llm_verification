alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_c@j | is_c@i & !is_a@j, !is_bos@i & !is_bos@j)
n1 = is_b | !is_a & !n0
n2 = rightmost(n0@i, !is_b@j)
n3 = is_a & is_bos
n4 = rightmost(!n3@i | !is_b@i & !n3@j, !n1@j & !n2@i | n2@j)
accept = n4

output accept
