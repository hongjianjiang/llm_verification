alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_b
n1 = rightmost(!is_bos@i, n0@i & !is_c@j | is_c@i & n0@j)
n2 = leftmost(!n1@i & is_a@i, !n1@j & !is_b@j | is_a@i & !is_c@j)
n3 = leftmost(is_bos@j | n1@j & is_a@j, is_c@j & n2@j)
n4 = rightmost(!n0@i & is_c@i, !n1@j)
accept = n4 & (!n4 | !n3 & !n1)

output accept
