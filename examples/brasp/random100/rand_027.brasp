alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_bos@i & is_c@i | !is_bos@i & !is_bos@j, is_a@i & !is_b@j)
n1 = rightmost(!is_a@j & n0@i, !is_b@i & is_c@j)
n2 = is_bos & !is_c
n3 = n1 | !is_c
n4 = leftmost(n3@i & is_b@j | n1@j, !n3@i & n0@j | is_c@j & n1@i)
accept = n4

output accept
