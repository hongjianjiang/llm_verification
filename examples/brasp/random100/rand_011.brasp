alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_c@j, is_b@j & !is_b@i | !is_bos@i & is_b@j)
n1 = rightmost(n0@j & is_b@j, !is_bos@j & is_a@j | !is_bos@i & is_c@j)
n2 = rightmost(n1@i, !n0@i & is_b@j)
n3 = !n1
n4 = rightmost(is_a@j | !n0@j, n0@j & n2@j | !is_bos@i & !is_b@j)
accept = n4

output accept
