alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_a@j, is_b@j)
n1 = rightmost(is_bos@j, !is_a@i & is_bos@j)
n2 = rightmost(!is_c@j & !is_a@i, is_bos@j)
n3 = leftmost(is_bos@j & n2@i | !is_a@j & !is_b@i, !is_b@i & n2@j | is_bos@j & !is_a@i)
accept = n3

output accept
