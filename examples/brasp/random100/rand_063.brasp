alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(!is_bos@j & is_bos@i | is_b@i, is_bos@i & !is_bos@j | is_b@j)
n1 = leftmost(is_a@j, !n0@i & !is_bos@i & is_a@j)
n2 = rightmost(is_a@i & n0@i | is_a@j, n1@j | n0@j)
n3 = leftmost(is_b@j | is_bos@i, !is_b@i & !n1@i & !is_a@j | !is_b@j)
n4 = rightmost(!n0@i, !is_bos@j & is_b@j | n2@i & n2@j)
accept = n4

output accept
