alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = !is_b & is_a
n1 = rightmost(is_bos@i | is_a@i, is_bos@i & n0@i & n0@j | !n0@j)
n2 = leftmost(n1@j & is_b@i, !is_bos@j & n0@j)
n3 = leftmost(n0@j & is_b@j | !is_bos@j & !is_bos@i, is_a@j)
n4 = rightmost(is_a@i, !is_b@i & is_bos@j | is_a@i & is_bos@j)
n5 = leftmost(!is_a@j & n3@j | n4@i, n2@j)
accept = n5

output accept
