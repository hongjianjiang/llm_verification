alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(!is_a@i | is_bos@i, !is_b@i & is_bos@j | is_b@i & is_bos@j)
n1 = leftmost(is_bos@j & is_c@i, is_a@i & !is_bos@i & !is_bos@j)
n2 = rightmost(n1@j & n1@i, !is_b@j)
n3 = rightmost(!is_c@i & n0@i | !is_c@j, is_c@j)
n4 = leftmost(!n3@i & is_a@j | !is_c@j & n2@j, !is_c@j & !n2@j | !n2@i & n0@j)
accept = n4 & (!n2 | !is_c)

output accept
