alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_a@j, !is_b@i & !is_b@j | is_a@j)
n1 = leftmost(n0@i & is_bos@j, !is_bos@i & is_a@j | is_a@i & !is_b@j)
n2 = leftmost(is_bos@i, is_b@i & is_b@j | n0@j & !is_a@j)
n3 = rightmost(!is_a@i & !n1@j | !n0@i, is_b@i & !is_b@j)
n4 = rightmost(!n1@i | !is_a@i & is_bos@j, !n2@i & !n2@j | !is_b@i & n2@i & !n1@j)
accept = n4

output accept
