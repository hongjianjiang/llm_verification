alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_b
n1 = leftmost(n0@i & is_b@j, is_b@j | is_b@i & is_bos@j)
n2 = leftmost(!n1@i & !is_bos@j | !is_a@j, is_bos@j)
n3 = leftmost(is_bos@i, !is_a@j & n0@j)
n4 = rightmost(is_b@i & !n3@i, is_b@j & !n1@j | is_b@i & !is_b@j)
accept = n4

output accept
