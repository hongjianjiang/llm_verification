alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(!is_b@i, !is_bos@j & !is_a@j | !is_a@i & !is_bos@j)
n1 = leftmost(n0@j & is_a@j, !is_bos@j | !is_b@j & !is_bos@i)
n2 = rightmost(is_b@j & is_a@j, is_bos@j)
n3 = rightmost(!n0@i & !is_b@j | is_b@i & is_bos@i, is_b@j & is_b@i | !n0@j)
n4 = rightmost(is_a@i & is_b@j | !is_bos@j, n0@j | is_bos@i & is_a@i & !n3@j)
accept = n4

output accept
