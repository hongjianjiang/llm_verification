alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_a
n1 = rightmost(is_b@i & is_bos@i | is_b@j, !is_bos@j | is_a@i & !is_bos@i & n0@j)
n2 = leftmost(n0@j & is_bos@j, !n1@j | n0@i & !is_bos@j)
n3 = leftmost(n2@i, n1@i & is_bos@j)
n4 = rightmost(is_bos@j & n1@i | is_a@j, !n1@j & !n3@i | n1@j & is_b@i)
accept = n4

output accept
