alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_bos@j & is_a@j | !is_bos@i, is_c@i & !is_a@i & is_b@j | !is_b@j & is_bos@j)
n1 = is_c
n2 = leftmost(!n1@j | is_b@i & is_a@j, !is_b@j)
n3 = leftmost(!n1@i & !is_bos@j, !n0@j & is_b@j | !n2@j)
n4 = rightmost(is_c@j, !is_bos@j)
n5 = is_c
n6 = leftmost(n4@i & is_b@i | !is_c@i & n0@j, is_c@j & !n3@i | n0@j & !n3@j)
accept = n6

output accept
