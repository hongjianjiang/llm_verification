alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_c@j | is_c@i & !is_a@i, is_c@i & is_a@j)
n1 = leftmost(is_b@j, !is_b@i & !n0@j | n0@j)
n2 = rightmost(!is_c@j, !is_b@i & n1@i & n1@j | is_a@i & is_a@j)
n3 = n2
n4 = rightmost(!n0@i, !n0@j & !n0@i | is_c@i & is_a@j)
accept = n4

output accept
