alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_c
n1 = leftmost(!n0@j & !n0@i, !is_a@i & is_c@j)
n2 = rightmost(is_c@i & n0@j | !is_c@i & is_bos@i, n1@i & is_bos@j | n0@i & !is_c@j)
n3 = rightmost(is_bos@j | n0@i, !is_c@i & !is_b@j)
n4 = rightmost(!n3@j & n0@i, !n0@j)
n5 = rightmost(!n4@j | is_b@i, is_b@j | n2@j)
accept = n5

output accept
