alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_a@i & !is_c@i | !is_bos@j, is_c@j | is_bos@j & !is_bos@i)
n1 = leftmost(n0@i, !is_b@i & !is_a@j | is_a@i & is_bos@j)
n2 = rightmost(is_a@j & n1@i, !is_bos@j)
n3 = n0 | !n0
n4 = false
n5 = leftmost(n3@i | n4@j & !is_bos@j, is_a@j)
n6 = rightmost(!n5@i, !n2@j | !n3@j & is_bos@i)
accept = n6

output accept
