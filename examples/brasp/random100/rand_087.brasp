alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_bos
n1 = rightmost(n0@i & is_c@j, n0@i & n0@j)
n2 = rightmost(is_c@i | !n1@j & n0@j, !is_bos@i & is_a@i & is_bos@j | is_a@j & !is_bos@i)
n3 = rightmost(!is_bos@j, !is_a@i & is_bos@j | is_c@j)
n4 = leftmost(!n2@i & !n2@j | !is_a@j & is_b@j, !is_a@i & is_bos@i & n0@j | !n3@i & !is_c@j)
accept = n4 & (n2 & is_c | n1)

output accept
