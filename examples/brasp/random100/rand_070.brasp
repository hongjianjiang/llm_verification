alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = !is_bos & is_b | !is_a
n1 = leftmost(!is_b@i & !is_a@i, is_a@i & !is_b@j | !is_b@j)
n2 = leftmost(is_bos@j & !n0@i | n1@j, n1@i & !is_bos@i & !is_a@j | !is_b@i & is_bos@j)
n3 = is_bos & !n1
n4 = rightmost(!is_b@i | n1@j & is_b@j, is_bos@j & !n3@i)
n5 = leftmost(!n0@j & n2@i, !n4@j)
n6 = leftmost(!n5@i, n1@j | n2@i & !n2@j)
accept = n6 & (n6 | is_a & !is_b)

output accept
