alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = leftmost(is_a@j & is_bos@i, !is_bos@i & !is_a@j | is_bos@j)
n1 = rightmost(is_b@i, n0@j & !is_a@i | !is_bos@i & !is_b@j)
n2 = rightmost(!n0@j | !is_b@i, !is_bos@i & is_b@j | n0@j)
n3 = rightmost(is_bos@i | !is_bos@i, is_a@i & !n2@j)
accept = n3 & (n3 | !is_a & n1)

output accept
