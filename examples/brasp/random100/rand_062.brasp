alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_b@i | is_a@j & is_b@i, is_c@j)
n1 = rightmost(is_b@j & !is_c@j, !is_c@i & is_b@j)
n2 = leftmost(!n0@i | is_a@j & n1@i, !is_bos@i & n0@i & is_c@j)
n3 = leftmost(!is_b@i & is_bos@j | is_b@i & n0@j, !n1@j)
accept = n3

output accept
