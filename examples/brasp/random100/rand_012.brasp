alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_c@j | is_a@i & is_c@j, !is_b@j & !is_b@i | is_a@i & !is_b@j)
n1 = rightmost(is_bos@i & is_c@i, !is_bos@i & is_a@j)
n2 = rightmost(!is_a@i, is_c@j)
n3 = rightmost(!is_b@j, !is_c@j)
accept = n3

output accept
