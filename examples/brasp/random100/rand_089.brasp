alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_a@i, is_c@i & !is_bos@j | !is_bos@i & is_b@i & is_a@j)
n1 = !n0 | is_bos & !is_c
n2 = rightmost(n0@i & !is_a@i | n0@j, is_c@i & !is_c@j | is_b@i & !is_bos@j)
n3 = leftmost(n1@i & is_c@i | is_a@j & is_a@i, n1@j | !is_c@j)
accept = n3

output accept
