alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(is_a@i, is_a@i & is_bos@j)
n1 = rightmost(!n0@j | !is_b@j & !is_a@i, is_b@j & is_a@i)
n2 = rightmost(is_b@i & !n0@j, is_bos@i & is_a@j | is_b@i & n1@j)
n3 = leftmost(!is_bos@j & !n0@j, !is_b@j & is_b@i)
n4 = is_a & n1
n5 = rightmost(!n1@j, n2@j)
accept = n5

output accept
