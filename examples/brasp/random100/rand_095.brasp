alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_a@i | is_bos@j, is_c@i & !is_c@j)
n1 = leftmost(!is_b@i & is_c@i | !is_a@i, !is_b@i & is_a@j | !is_a@i & is_bos@j)
n2 = !n0
n3 = rightmost(is_b@j & n1@j | n0@i, !is_a@j & n2@j)
n4 = rightmost(!is_a@i, !is_b@j)
n5 = leftmost(!is_bos@j | !n4@i, n1@i & !is_c@j)
accept = n5

output accept
