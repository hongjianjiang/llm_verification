alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_c@j & is_b@i, is_b@j)
n1 = leftmost(!is_bos@j | is_b@i, is_a@i & !n0@i & is_c@j | !is_c@i & is_a@j)
n2 = leftmost(!is_c@j | is_b@i & !is_a@j, n1@i & is_b@j)
n3 = leftmost(!is_bos@i, !is_bos@i & is_c@j)
n4 = rightmost(!is_c@j & !n3@i | !n2@i, n1@i & !n1@j | !is_b@i & is_c@j)
accept = n4

output accept
