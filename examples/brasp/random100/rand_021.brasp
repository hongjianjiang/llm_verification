alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_c | !is_c
n1 = !is_c
n2 = leftmost(is_b@j | !is_c@i & !is_c@j, is_b@j)
n3 = rightmost(is_b@j, !n2@i & !n1@j | !is_a@j & !is_c@j)
n4 = rightmost(is_a@i & !is_b@j, is_a@i & is_bos@i & !n2@j | !n3@j & is_c@i)
n5 = rightmost(!n2@i & n0@j | n3@j & n0@j, n0@j & n4@i | !is_bos@j & n2@i)
accept = n5

output accept
