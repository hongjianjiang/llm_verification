alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_bos@j, !is_a@j | !is_bos@j)
n1 = rightmost(is_c@i | !is_bos@i, !is_b@i & n0@j)
n2 = leftmost(n1@j, is_c@j & n1@i | !is_c@i & n1@j)
n3 = leftmost(is_bos@j & !n1@j, n0@j & is_bos@j | n1@i & !is_a@j)
n4 = n2 & n3
n5 = rightmost(n4@j, !is_b@i & is_bos@j | is_a@j)
accept = n5

output accept
