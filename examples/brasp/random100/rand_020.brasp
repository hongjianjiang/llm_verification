alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(is_b@i, is_b@j)
n1 = rightmost(!n0@i & !is_a@j, !n0@i & !n0@j)
n2 = rightmost(is_a@i & !is_bos@j | is_bos@j, n0@i & !is_b@j)
n3 = leftmost(is_b@i & !is_bos@j | n1@i & is_b@j, !is_bos@j)
accept = n3 & is_a & !n0

output accept
