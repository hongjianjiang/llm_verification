alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_bos@j & !is_c@i, is_b@i & is_bos@j | !is_a@i & is_c@i & !is_a@j)
n1 = !is_b & is_c | is_bos
n2 = leftmost(n1@j & !n0@i, is_a@j & !is_c@j)
n3 = rightmost(n2@i | !is_b@j, is_a@i & !n2@i & !is_bos@j | n0@i & !is_c@j)
accept = n3

output accept
