alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(is_a@i, !is_b@i & !is_b@j)
n1 = rightmost(!is_bos@i | !n0@j, is_b@i & is_b@j | !is_a@j)
n2 = rightmost(!is_b@j | is_bos@i, !n0@i & n1@j)
n3 = rightmost(!is_a@j & is_a@i | is_a@j & !is_bos@j, !n1@j & is_a@j)
accept = n3

output accept
