alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(is_bos@j | !is_a@j & is_a@i, is_a@j & is_b@j | is_bos@j)
n1 = is_bos | is_a
n2 = rightmost(is_bos@j & is_bos@i | !is_bos@j, is_bos@i & !is_a@j | !n0@j & n1@j)
n3 = rightmost(n0@j & is_bos@j | !n2@i & is_a@j, !n1@i & n2@i & is_a@j)
n4 = leftmost(n1@i & !is_bos@j | n2@j & !n1@j, !n2@i & n0@j | is_a@j)
accept = n4

output accept
