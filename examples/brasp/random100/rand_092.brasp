alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_b & is_c | is_bos
n1 = rightmost(!is_a@i & !is_b@j | !is_b@i, !is_b@j & n0@j | !is_b@j & !is_c@i)
n2 = leftmost(!n1@i, !is_b@i & is_bos@j)
n3 = rightmost(is_c@i & is_b@j, !is_c@j)
n4 = rightmost(is_bos@j | n2@i, is_a@i & n2@j | !is_c@j)
accept = n4

output accept
