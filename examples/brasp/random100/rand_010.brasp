alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_c@i & is_bos@j, !is_a@j)
n1 = leftmost(is_b@i, !is_a@i & is_bos@j | is_bos@j)
n2 = n0
n3 = !is_a | !n1
n4 = rightmost(is_c@j & is_b@i | is_b@j, !n0@j | n0@j & is_bos@j)
n5 = leftmost(is_bos@j | !is_a@j & is_a@i, is_bos@j & n0@i)
n6 = rightmost(n4@j, n4@i & is_c@j)
accept = n6 & (n4 & !is_c | n5 & is_a)

output accept
