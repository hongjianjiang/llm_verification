alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(!is_a@j & !is_bos@j | is_a@j & !is_bos@i, !is_bos@j & !is_b@j | is_a@j)
n1 = leftmost(!is_b@i & !n0@j, n0@i & !n0@j)
n2 = leftmost(n1@j & is_b@j, !is_a@i & is_b@j | n1@i & !n1@j)
n3 = is_bos
n4 = rightmost(n1@i & n1@j | !is_a@i, !is_b@j & !is_a@i | !n0@j)
accept = n4

output accept
