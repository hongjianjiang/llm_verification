alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = !is_b & is_bos
n1 = rightmost(!is_c@i | !n0@i & is_b@i, !is_bos@i & is_bos@j)
n2 = rightmost(!is_a@i | is_c@i & n0@j, !is_a@i & is_b@j | !n1@j)
n3 = is_a & !n2 | !n2 & !is_b
n4 = rightmost(n0@j, is_a@i & is_bos@i & !n3@j)
n5 = leftmost(n2@j & !is_bos@j, is_a@i & n0@j | is_c@j & !n3@i)
accept = n5 & !n3 & n2

output accept
