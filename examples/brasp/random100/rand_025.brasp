alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_bos@i & !is_bos@j | is_a@i, !is_a@j & !is_b@i)
n1 = is_a | !n0 & is_c
n2 = n0
n3 = leftmost(is_bos@j & !is_b@i, n0@i & n0@j | is_b@j & is_a@j)
n4 = rightmost(is_bos@j & n3@j | is_bos@j, !n0@j | !n3@i & is_a@j)
n5 = leftmost(n3@i & n4@j | !is_c@i, is_a@i & n3@j)
n6 = leftmost(n2@j, is_c@j | is_a@i & !n4@j)
accept = n6

output accept
