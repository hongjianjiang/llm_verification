alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = is_a | is_bos
n1 = leftmost(n0@i, is_b@j & !n0@j | is_bos@j & n0@j)
n2 = leftmost(is_a@i & is_bos@j | is_a@i & !is_a@j, !is_a@j)
n3 = rightmost(is_bos@i | n0@i, is_a@j | n2@i & !is_bos@j)
n4 = !n1 | !is_bos
n5 = rightmost(n4@j & n3@j | !n3@j, is_a@j | is_b@i & is_b@j)
accept = n5

output accept
