alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(is_bos@j | !is_bos@j & !is_b@i, !is_b@i & !is_b@j | is_b@j & is_b@i)
n1 = leftmost(!is_a@j & is_bos@i | !is_bos@j & !is_b@i, is_bos@j & !n0@j | !n0@i & !is_b@j)
n2 = leftmost(n1@i, is_b@i & is_a@j)
n3 = rightmost(is_b@j | !n0@i & n0@j, !is_a@i & is_a@j)
accept = n3

output accept
