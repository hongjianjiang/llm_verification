alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(is_b@i, is_bos@j & !is_bos@i)
n1 = is_bos & is_b
n2 = rightmost(n0@i & !is_c@j | !n1@j, is_a@i & !n1@j | n1@j)
n3 = !is_bos
n4 = rightmost(n3@i | n1@j & n0@i, is_b@j & !n0@i | !is_b@i & !is_b@j)
n5 = leftmost(!is_b@j & n2@j | !is_bos@i, !n4@i & !is_b@j | is_c@j & n2@i)
n6 = leftmost(n3@i | n3@i & n1@i, n4@i & !n1@j | !is_b@i & n5@j)
accept = n6

output accept
