alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(!is_bos@i & is_b@j, !is_a@j | is_b@i & !is_bos@i & is_a@j)
n1 = rightmost(is_b@j & is_bos@j, n0@i & n0@j | n0@j)
n2 = leftmost(n0@i & is_a@j, !n1@i & !is_b@i & n0@j | is_b@j)
accept = n2 & (!is_bos | is_b & !is_bos)

output accept
