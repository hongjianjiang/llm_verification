alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = rightmost(is_bos@i, is_a@i & is_b@j)
n1 = n0
n2 = leftmost(!n0@i | !is_b@j, !is_bos@i & !n1@j | !is_bos@j & is_a@i)
n3 = rightmost(is_b@i | is_b@j & is_b@i, !n0@i & !is_a@j)
n4 = rightmost(!is_b@i & is_bos@i | n3@i, n3@j & is_a@i | is_bos@j & n0@i)
accept = n4

output accept
