alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
n0 = !is_a & is_bos | is_bos
n1 = leftmost(is_b@j, !is_bos@j & !is_bos@i | n0@j)
n2 = rightmost(n1@j & !is_bos@j | !is_b@i & n1@j, n0@i & n1@j | !n1@j)
n3 = rightmost(n0@j & n1@j | !is_a@i, is_bos@i & n0@i & !n1@j | n0@i & n1@j)
n4 = rightmost(!n3@i | !n1@j & n0@j, n1@j | is_bos@j & n2@j)
n5 = rightmost(n1@j & n4@i, n4@j & !is_a@j | n4@i & !n2@j)
accept = n5 & (is_a | n0 & n2)

output accept
