alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_c | !is_bos
n1 = leftmost(is_a@j | is_bos@i, is_c@i & is_b@i & is_c@j)
n2 = rightmost(is_b@i | !is_bos@j & !n1@j, !is_a@i & is_bos@i & is_a@j | is_b@i & n1@j)
n3 = rightmost(!is_bos@j, !is_b@j | !n1@j & !is_c@i)
accept = n3

output accept
