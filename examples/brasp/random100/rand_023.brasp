alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = rightmost(!is_bos@i | !is_a@i, is_c@j)
n1 = leftmost(!is_a@j | n0@i, n0@i & is_bos@j | is_c@j)
n2 = leftmost(n0@j & n1@j, is_b@j | !n0@i & !is_bos@j)
n3 = leftmost(!n0@j & is_a@j | !n1@j, n0@i & n1@j | !is_b@i & !n2@i & !n0@j)
accept = n3

output accept
