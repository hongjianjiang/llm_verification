alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = is_bos | is_c
n1 = leftmost(n0@i, !is_a@i & is_c@j | is_a@i & n0@i & is_b@j)
n2 = is_a | !is_b
n3 = rightmost(is_bos@j & !n1@i, !is_b@j & !is_c@j | is_bos@j)
n4 = rightmost(is_c@i & is_a@i | n1@i, n2@j | n1@i & !is_a@i & !is_a@j)
n5 = rightmost(n2@j & !is_c@j | is_bos@j, !is_bos@i & !n2@j | is_b@i & is_bos@i & is_b@j)
n6 = rightmost(is_bos@j & is_a@i | !n5@j & !n4@i, !is_b@j & !n1@i)
accept = n6

output accept
