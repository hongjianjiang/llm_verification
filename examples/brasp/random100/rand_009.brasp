alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = !is_bos & is_a | !is_bos
n1 = leftmost(false, is_bos@i & is_a@j | is_bos@j)
n2 = leftmost(!is_bos@i | !n1@j, n0@i & is_c@j)
n3 = !is_c & n0 | n1 & n0
n4 = leftmost(is_c@j & !is_bos@i | is_a@j, !n3@i & !is_c@j | !is_c@i & n3@j)
accept = n4

output accept
