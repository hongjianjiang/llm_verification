alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
n0 = leftmost(is_a@j | is_b@j & is_bos@j, is_a@j)
n1 = leftmost(n0@j | !n0@j, is_c@j)
n2 = rightmost(!is_c@j | !is_b@i, n1@i & !is_c@j | !n1@j)
n3 = rightmost(!n0@i | is_c@j & !is_bos@j, n2@j & is_c@i)
accept = n3

output accept
