logic past-strict
alphabet a b

is_a := sym(a)@i
a_before := (!(((is_a@j & true) | !(!(is_a@j))))) S ((((is_a@j & true) | !(!(is_a@j))) & (is_a@j & true)))
two_a_before := (!(((is_a@j & a_before@j) | !(!(is_a@j))))) S ((((is_a@j & a_before@j) | !(!(is_a@j))) & (is_a@j & a_before@j)))
last_is_second_a := (is_a@i & a_before@i)
at_least_two_a := (two_a_before@i | last_is_second_a@i)

output := at_least_two_a@i
evaluate at i = |w| (the final input position)
