logic past-strict
alphabet a b

f_0 := sym(a)@i
f_1 := sym(b)@i
f_2 := P(f_0@j)
f_3 := (f_1@i & f_2@i)
f_4 := P(f_3@j)
f_5 := (f_0@i & f_4@i)
f_6 := P(f_5@j)
f_7 := (f_1@i & f_6@i)
f_8 := P(f_7@j)
f_9 := (f_0@i & f_8@i)
f_10 := P(f_9@j)
f_11 := (f_1@i & f_10@i)
f_12 := P(f_11@j)
f_13 := (f_0@i & f_12@i)
f_14 := P(f_13@j)
f_15 := (f_1@i & f_14@i)
f_16 := P(f_15@j)
f_17 := (f_0@i & f_16@i)
f_18 := !(f_17@i)
f_19 := P(f_17@j)
f_20 := !(f_19@i)
f_21 := (f_18@i & f_20@i)
f_22 := !(f_21@i)

output := f_22@i
evaluate at i = |w| (the final input position)
