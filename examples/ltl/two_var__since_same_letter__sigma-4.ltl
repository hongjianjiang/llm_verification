logic past-strict
alphabet marker a b c d

f_0 := sym(a)@i
f_1 := sym(b)@i
f_2 := sym(c)@i
f_3 := sym(d)@i
f_4 := sym(marker)@i
f_5 := (!((((!((f_0@i & f_0@j)) & !((f_1@i & f_1@j))) & !((f_2@i & f_2@j))) & !((f_3@i & f_3@j))))) S (f_4@j)

output := f_5@i
evaluate at i = |w| (the final input position)
