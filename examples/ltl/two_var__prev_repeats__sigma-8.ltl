logic past-strict
alphabet a b c d e f g h

f_0 := sym(a)@i
f_1 := sym(b)@i
f_2 := sym(c)@i
f_3 := sym(d)@i
f_4 := sym(e)@i
f_5 := sym(f)@i
f_6 := sym(g)@i
f_7 := sym(h)@i
f_8 := Y(!((((((((!((f_0@i & f_0@j)) & !((f_1@i & f_1@j))) & !((f_2@i & f_2@j))) & !((f_3@i & f_3@j))) & !((f_4@i & f_4@j))) & !((f_5@i & f_5@j))) & !((f_6@i & f_6@j))) & !((f_7@i & f_7@j)))))

output := f_8@i
evaluate at i = |w| (the final input position)
