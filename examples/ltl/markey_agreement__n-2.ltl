logic past-strict
alphabet 000 001 010 011 100 101 110 111

f_0 := bit(1)@i
f_1 := !(f_0@i)
f_2 := bit(2)@i
f_3 := !(f_2@i)
f_4 := bit(0)@i
f_5 := !(f_4@i)
f_6 := H(!(((!((!((f_0@i & f_0@j)) & !((f_1@i & f_1@j)))) & !((!((f_2@i & f_2@j)) & !((f_3@i & f_3@j))))) & (!((f_4@i & f_4@j)) & !((f_5@i & f_5@j))))))

output := f_6@i
evaluate at i = |w| (the final input position)
