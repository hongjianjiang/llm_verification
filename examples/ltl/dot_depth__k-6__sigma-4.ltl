logic past-strict
alphabet a b c d

f_0 := sym(b)@i
f_1 := sym(a)@i
f_2 := sym(d)@i
f_3 := sym(c)@i
f_4 := P(f_1@j)
f_5 := (f_0@i & f_4@i)
f_6 := P(f_5@j)
f_7 := (f_3@i & f_6@i)
f_8 := P(f_7@j)
f_9 := (f_2@i & f_8@i)
f_10 := P(f_9@j)
f_11 := (f_1@i & f_10@i)
f_12 := P(f_11@j)
f_13 := (f_0@i & f_12@i)
f_14 := !(f_13@i)
f_15 := P(f_13@j)
f_16 := !(f_15@i)
f_17 := (f_14@i & f_16@i)
f_18 := !(f_17@i)

output := f_18@i
evaluate at i = |w| (the final input position)
