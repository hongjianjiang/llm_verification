logic past-strict
alphabet a b

is_a := sym(a)@i
is_b := sym(b)@i
is_bos := bos@i
always := true
prev_is_a := (!(always@j)) S ((always@j & is_a@j))
prev_is_b := (!(always@j)) S ((always@j & is_b@j))
back2_is_b := (!(always@j)) S ((always@j & prev_is_b@j))
prev_is_bos := (!(always@j)) S ((always@j & is_bos@j))
back2_is_bos := (!(always@j)) S ((always@j & prev_is_bos@j))
back3_is_bos := (!(always@j)) S ((always@j & back2_is_bos@j))
is_baa := (is_a@i & prev_is_a@i & back2_is_b@i & back3_is_bos@i)

output := is_baa@i
evaluate at i = |w| (the final input position)
