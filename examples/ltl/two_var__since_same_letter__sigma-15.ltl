logic past-strict
alphabet marker s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14

f_0 := sym(s0)@i
f_1 := sym(s1)@i
f_2 := sym(s2)@i
f_3 := sym(s3)@i
f_4 := sym(s4)@i
f_5 := sym(s5)@i
f_6 := sym(s6)@i
f_7 := sym(s7)@i
f_8 := sym(s8)@i
f_9 := sym(s9)@i
f_10 := sym(s10)@i
f_11 := sym(s11)@i
f_12 := sym(s12)@i
f_13 := sym(s13)@i
f_14 := sym(s14)@i
f_15 := sym(marker)@i
f_16 := (!(((((((((((((((!((f_0@i & f_0@j)) & !((f_1@i & f_1@j))) & !((f_2@i & f_2@j))) & !((f_3@i & f_3@j))) & !((f_4@i & f_4@j))) & !((f_5@i & f_5@j))) & !((f_6@i & f_6@j))) & !((f_7@i & f_7@j))) & !((f_8@i & f_8@j))) & !((f_9@i & f_9@j))) & !((f_10@i & f_10@j))) & !((f_11@i & f_11@j))) & !((f_12@i & f_12@j))) & !((f_13@i & f_13@j))) & !((f_14@i & f_14@j))))) S (f_15@j)

output := f_16@i
evaluate at i = |w| (the final input position)
