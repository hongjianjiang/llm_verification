logic past-strict
alphabet a b

f_0 := sym(a)@i
f_1 := sym(b)@i
f_2 := P(f_0@j)
f_3 := (f_1@i & f_2@i)
f_4 := P(f_3@j)
f_5 := (f_0@i & f_4@i)
f_6 := P(f_5@j)
f_7 := (f_1@i & f_6@i)
f_8 := P(f_7@j)
f_9 := (f_0@i & f_8@i)
f_10 := P(f_9@j)
f_11 := (f_1@i & f_10@i)
f_12 := P(f_11@j)
f_13 := (f_0@i & f_12@i)
f_14 := P(f_13@j)
f_15 := (f_1@i & f_14@i)
f_16 := P(f_15@j)
f_17 := (f_0@i & f_16@i)
f_18 := P(f_17@j)
f_19 := (f_1@i & f_18@i)
f_20 := P(f_19@j)
f_21 := (f_0@i & f_20@i)
f_22 := P(f_21@j)
f_23 := (f_1@i & f_22@i)
f_24 := P(f_23@j)
f_25 := (f_0@i & f_24@i)
f_26 := P(f_25@j)
f_27 := (f_1@i & f_26@i)
f_28 := P(f_27@j)
f_29 := (f_0@i & f_28@i)
f_30 := P(f_29@j)
f_31 := (f_1@i & f_30@i)
f_32 := P(f_31@j)
f_33 := (f_0@i & f_32@i)
f_34 := P(f_33@j)
f_35 := (f_1@i & f_34@i)
f_36 := P(f_35@j)
f_37 := (f_0@i & f_36@i)
f_38 := P(f_37@j)
f_39 := (f_1@i & f_38@i)
f_40 := P(f_39@j)
f_41 := (f_0@i & f_40@i)
f_42 := P(f_41@j)
f_43 := (f_1@i & f_42@i)
f_44 := P(f_43@j)
f_45 := (f_0@i & f_44@i)
f_46 := !(f_45@i)
f_47 := P(f_45@j)
f_48 := !(f_47@i)
f_49 := (f_46@i & f_48@i)
f_50 := !(f_49@i)

output := f_50@i
evaluate at i = |w| (the final input position)
