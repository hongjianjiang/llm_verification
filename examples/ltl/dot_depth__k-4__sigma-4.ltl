logic past-strict
alphabet a b c d

f_0 := sym(d)@i
f_1 := sym(c)@i
f_2 := sym(b)@i
f_3 := sym(a)@i
f_4 := P(f_3@j)
f_5 := (f_2@i & f_4@i)
f_6 := P(f_5@j)
f_7 := (f_1@i & f_6@i)
f_8 := P(f_7@j)
f_9 := (f_0@i & f_8@i)
f_10 := !(f_9@i)
f_11 := P(f_9@j)
f_12 := !(f_11@i)
f_13 := (f_10@i & f_12@i)
f_14 := !(f_13@i)

output := f_14@i
evaluate at i = |w| (the final input position)
