  "q:not:f_7" -> "q:not:f_7" [label="leave"];
  "q:f_9" -> "q:f_7" [label="carry"];
  "q:f_9" -> "q:f_9" [label="leave"];
  "q:not:f_9" -> "q:not:f_7" [label="carry"];
  "q:not:f_9" -> "q:not:f_9" [label="leave"];
  "q:f_11" -> "q:f_9" [label="carry"];
  "q:f_11" -> "q:f_11" [label="leave"];
  "q:not:f_11" -> "q:not:f_9" [label="carry"];
  "q:not:f_11" -> "q:not:f_11" [label="leave"];
