  "q:not:f_15" -> "q:not:f_13" [label="carry"];
  "q:not:f_15" -> "q:not:f_15" [label="leave"];
  "q:__output__" -> "q:f_13" [label="carry"];
  "q:__output__" -> "q:__output__" [label="leave\nleave"];
  "q:__output__" -> "q:f_15" [label="carry"];
  "q:not:__output__" -> "q:not:f_13" [label="carry"];
