digraph pvwaa {
  rankdir=LR;
  node [shape=circle, fontname="monospace"];
  edge [fontname="monospace", fontsize=10];
  __start__ [shape=point];
  __start__ -> "q:contains_a";
  "q:not:is_a" [shape=doublecircle];
  "q:not:a_before" [shape=doublecircle];
  "q:not:contains_a" [shape=doublecircle];
  "q:a_before" -> "q:is_a" [label="a/carry\nb/carry"];
  "q:a_before" -> "q:not:is_a" [label="a/carry\nb/carry"];
  "q:a_before" -> "q:a_before" [label="a/leave\nb/leave"];
  "q:not:a_before" -> "q:not:is_a" [label="a/carry\nb/carry"];
  "q:not:a_before" -> "q:is_a" [label="a/carry\nb/carry"];
  "q:not:a_before" -> "q:not:a_before" [label="a/leave\nb/leave"];
  "q:contains_a" -> "q:is_a" [label="a/goto\nb/goto"];
  "q:contains_a" -> "q:a_before" [label="a/goto\nb/goto"];
  "q:not:contains_a" -> "q:not:is_a" [label="a/goto\nb/goto"];
  "q:not:contains_a" -> "q:not:a_before" [label="a/goto\nb/goto"];
}