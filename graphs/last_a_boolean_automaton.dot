digraph boolean_automaton {
  rankdir=LR;
  node [shape=circle, fontname="monospace"];
  edge [fontname="monospace", fontsize=10];
  __start__ [shape=point];
  __start__ -> "s0";
  "s2" [shape=doublecircle];
  "s3" [shape=doublecircle];
  "s0" -> "s1" [label="a"];
  "s0" -> "s0" [label="b"];
  "s1" -> "s2" [label="a"];
  "s1" -> "s3" [label="b"];
  "s2" -> "s2" [label="a"];
  "s2" -> "s3" [label="b"];
  "s3" -> "s2" [label="a"];
  "s3" -> "s3" [label="b"];
}