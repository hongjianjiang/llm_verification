alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_bos@j & !is_c@j | !is_c@i & !is_bos@j, !is_c@i & !is_bos@j & !is_a@j | !is_bos@j & !is_a@j & is_b@j)
h2_1 = rightmost(true, !h1_1@i & !is_b@j)
h3_1 = rightmost(!is_c@i & !is_bos@j & !is_c@j | !is_bos@j & !is_c@j, !is_c@i & !h2_1@i & !is_a@j | !is_a@j & is_b@j)
h4_1 = rightmost(h1_1@i & !h2_1@i | !is_c@i & h1_1@i & !h2_1@i & !is_bos@j & !is_a@j & !h1_1@j & h2_1@j, !h2_1@i | h1_1@i & !is_bos@j)
accept = !is_bos & !h1_1 & h2_1 & !h3_1 & !h4_1 | !is_bos & !h1_1 & !h3_1 & !h4_1

output accept
