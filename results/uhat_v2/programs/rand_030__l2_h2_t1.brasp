alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(true, !is_c@j)
h1_2 = leftmost(is_bos@i & !is_a@i & is_b@i & !is_c@i & is_bos@j & is_a@j & is_b@j & is_c@j, is_bos@i & !is_a@i & is_b@i & !is_c@i & is_bos@j & is_a@j & is_b@j & is_c@j)
h2_1 = rightmost(!is_b@i & !h1_2@i & !is_bos@j & !h1_2@j, !is_b@i & !h1_2@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j & !h1_2@j)
accept = !is_bos & !is_b & !h1_1 & h2_1

output accept
