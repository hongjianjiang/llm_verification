alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(true, is_a@i & !is_b@i & !is_bos@j & !is_a@j & is_b@j)
h1_2 = leftmost(is_bos@i & !is_a@i & is_b@i & is_bos@j & is_a@j & is_b@j, is_bos@i & is_b@i & is_bos@j & !is_a@j & !is_b@j)
h2_1 = rightmost(!h1_1@i & !h1_2@i & !is_bos@j & is_a@j & !is_b@j & !h1_2@j, !h1_1@i & is_a@j & !is_b@j)
h2_2 = leftmost(!is_a@i & is_b@i & !h1_1@i & !h1_2@i & !is_bos@j & is_a@j & !is_b@j & !h1_2@j, !is_a@i & is_b@i & !h1_1@i & !is_bos@j & is_a@j & !is_b@j & !h1_2@j)
h3_1 = rightmost(is_bos@i & !is_a@i & is_b@i & !h1_1@i & !h1_2@i & h2_1@i & h2_2@i & is_bos@j & is_b@j & h1_2@j & h2_1@j & h2_2@j, is_bos@i & is_b@i & h1_1@i & h1_2@i & h2_2@i & is_b@j & h1_2@j & !h2_1@j & h2_2@j)
h3_2 = leftmost(!h1_1@i & !is_bos@j & is_a@j & !is_b@j & !h2_1@j & !h2_2@j, !h1_1@i & is_a@j)
h4_2 = leftmost(is_b@i & h1_1@i & h2_2@i & is_bos@j & is_b@j & h1_1@j & h1_2@j & h2_1@j, is_bos@i & !is_a@i & h1_2@i & h3_1@i & is_bos@j & !is_a@j & h1_2@j & h2_1@j & h2_2@j & h3_1@j)
h5_1 = rightmost(!h4_2@i, !h1_1@i & !is_b@j & !h1_2@j & !h2_2@j)
accept = !is_bos & !h2_1 & !h2_2 & !h3_1 & !h3_2 & !h5_1

output accept
