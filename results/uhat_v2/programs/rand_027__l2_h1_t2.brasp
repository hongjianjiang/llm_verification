alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_a@i & !is_bos@j & !is_a@j | !is_a@i & !is_bos@j & !is_a@j & is_c@j, !is_a@i & !is_b@j & is_c@j | !is_a@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j)
h2_1 = rightmost(!is_c@j | !is_a@i & h1_1@j, !is_bos@i & !is_c@j | !is_c@j)
accept = !is_bos & !is_a & h1_1 & !h2_1 | !is_a & h1_1 & !h2_1

output accept
