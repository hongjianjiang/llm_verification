alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_b@j, !is_bos@i & !is_c@j)
h1_2 = leftmost(true, !is_a@j)
h2_1 = rightmost(!h1_1@i & !is_bos@j & !is_b@j, !h1_1@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j & !h1_1@j)
h2_2 = leftmost(is_bos@i & is_a@i & is_b@i & is_c@i & !h1_1@i & !h1_2@i & is_bos@j & !is_a@j & is_b@j & h1_1@j & !h1_2@j, is_bos@i & is_a@i & is_b@i & is_c@i & h1_1@i & h1_2@i & is_bos@j & is_a@j & !is_b@j & is_c@j & h1_1@j & h1_2@j)
h3_1 = rightmost(true, !is_c@j)
h3_2 = leftmost(is_bos@i & is_a@i & is_b@i & is_c@i & !h1_2@i & h2_1@i & is_bos@j & !is_c@j & !h1_1@j & h1_2@j & h2_1@j & h2_2@j, is_bos@i & !is_a@i & !is_b@i & h1_1@i & !h1_2@i & h2_1@i & !is_bos@j & !is_a@j & !h1_1@j & !h1_2@j & h2_2@j)
h4_1 = rightmost(!h1_1@i & !h2_1@i & !h3_1@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j, !h2_1@i & !h3_2@i & !is_bos@j)
h6_1 = rightmost(!h1_1@i & !h2_1@i & !h3_1@i & h4_1@i & !is_bos@j & is_a@j & !is_b@j, !h2_1@i & !h3_1@i & !is_bos@j & !is_b@j)
h7_1 = rightmost(is_a@i & !is_b@i & !is_c@i & !h1_1@i & !h2_1@i & !h3_1@i & h4_1@i & h6_1@i & !is_bos@j & is_a@j & !is_b@j & h1_1@j & h3_1@j, !h2_1@i & !h3_1@i & !is_bos@j)
h9_2 = leftmost(!h1_1@i & h1_2@i & !h2_1@i & !h3_1@i & h4_1@i & h6_1@i & !is_bos@j & h1_1@j & h1_2@j & h3_1@j, !h2_1@i & !h3_1@i & h4_1@i)
accept = !is_bos & !h2_2 & !h3_2 & !h4_1 & !h6_1 & !h7_1 & !h9_2

output accept
