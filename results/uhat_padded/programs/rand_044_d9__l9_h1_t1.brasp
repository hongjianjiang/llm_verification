alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_a@i & !is_b@i & is_c@i & !is_bos@j, !is_a@i & !is_b@i & is_c@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j)
h2_1 = rightmost(is_bos@i & is_a@i & is_b@i & h1_1@i & is_bos@j & is_a@j & is_b@j & is_c@j & h1_1@j, is_bos@i & !is_a@i & is_b@i & is_c@i & h1_1@i & !is_bos@j & is_b@j & !is_c@j & h1_1@j)
h3_1 = rightmost(!is_a@i & !is_b@i & is_c@i & h1_1@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j, !is_a@i & !is_b@i & h1_1@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j & !h2_1@j)
h4_1 = rightmost(!h2_1@i, !h1_1@i & !h1_1@j & !h2_1@j & !h3_1@j)
h5_1 = rightmost(!is_a@i & !is_b@i & is_c@i & !is_bos@j & !h1_1@j, !is_b@i & is_c@i & !h4_1@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j)
h6_1 = rightmost(!is_b@i & is_c@i & h1_1@i & !h4_1@i & h5_1@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j & !h1_1@j & h4_1@j & !h5_1@j, !is_b@i & is_c@i & is_a@j & !is_b@j & !h1_1@j & !h2_1@j)
h8_1 = rightmost(!h4_1@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j, !is_bos@i & !h4_1@i)
accept = !is_bos & !h1_1 & !h2_1 & !h3_1 & !h5_1 & !h6_1 & !h8_1

output accept
