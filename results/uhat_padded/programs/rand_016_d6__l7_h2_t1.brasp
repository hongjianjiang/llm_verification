alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j, !is_bos@j & !is_a@j & is_b@j)
h2_1 = rightmost(!is_bos@i & !h1_1@i & !is_a@j & is_b@j, !h1_1@i & !is_a@j & h1_1@j)
h2_2 = leftmost(!is_bos@j & !is_a@j & is_b@j & h1_1@j, !is_bos@j & is_b@j)
h4_1 = rightmost(!h2_1@i & h2_2@i & !is_bos@j & h1_1@j & !h2_1@j, !is_a@j & is_b@j)
accept = !is_bos & !h2_1 & !h4_1

output accept
