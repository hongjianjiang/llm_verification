logic past-strict
alphabet marker a b c d e f g h i j k l m n o p

f_0 := sym(a)@i
f_1 := sym(b)@i
f_2 := sym(c)@i
f_3 := sym(d)@i
f_4 := sym(e)@i
f_5 := sym(f)@i
f_6 := sym(g)@i
f_7 := sym(h)@i
f_8 := sym(i)@i
f_9 := sym(j)@i
f_10 := sym(k)@i
f_11 := sym(l)@i
f_12 := sym(m)@i
f_13 := sym(n)@i
f_14 := sym(o)@i
f_15 := sym(p)@i
f_16 := sym(marker)@i
f_17 := (!((((((((((((((((!((f_0@i & f_0@j)) & !((f_1@i & f_1@j))) & !((f_2@i & f_2@j))) & !((f_3@i & f_3@j))) & !((f_4@i & f_4@j))) & !((f_5@i & f_5@j))) & !((f_6@i & f_6@j))) & !((f_7@i & f_7@j))) & !((f_8@i & f_8@j))) & !((f_9@i & f_9@j))) & !((f_10@i & f_10@j))) & !((f_11@i & f_11@j))) & !((f_12@i & f_12@j))) & !((f_13@i & f_13@j))) & !((f_14@i & f_14@j))) & !((f_15@i & f_15@j))))) S (f_16@j)

output := f_17@i
evaluate at i = |w| (the final input position)
