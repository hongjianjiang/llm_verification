alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j & is_a@j & !is_b@j, true)
h2_1 = rightmost(is_a@i & !is_b@i & !is_a@j, is_a@i & !is_b@i & !is_b@j)
h3_1 = rightmost(h1_1@i & !h2_1@i & !is_bos@j & is_b@j & h1_1@j, true)
accept = !is_bos & h1_1 & !h2_1 & h3_1

output accept
