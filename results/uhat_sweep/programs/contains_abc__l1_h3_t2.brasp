alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_a@i & !is_b@i & is_c@i & !is_c@j | !is_c@i & !is_a@j & !is_b@j, !is_c@i & !is_c@j | !is_b@j & !is_c@j)
h1_2 = leftmost(!is_b@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j | is_bos@i & is_a@i & is_b@i & !is_c@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j, true)
h1_3 = rightmost(!is_a@i & is_c@i & !is_bos@j & !is_a@j & is_b@j | !is_bos@j & !is_a@j & is_b@j, !is_bos@j)
accept = !h1_1 & h1_2 & h1_3 | !is_a & !h1_1 & h1_2 & h1_3

output accept
