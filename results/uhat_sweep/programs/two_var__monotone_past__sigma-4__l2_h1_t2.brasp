alphabet a b c d

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
is_d = symbol d
h1_1 = rightmost(is_bos@i & is_a@i & !is_b@i & is_c@i & is_d@i & is_a@j & is_b@j & is_d@j | !is_a@i & !is_d@i & is_a@j & is_c@j & is_d@j, is_bos@i & is_b@i & is_d@i & is_bos@j & !is_a@j & is_b@j | !is_a@i & is_c@i & !is_d@i & is_bos@j & is_a@j & !is_c@j)
h2_1 = rightmost(true, true)
accept = is_bos & !is_a & !is_b & !is_c & !is_d & !h1_1 & !h2_1 | is_bos & !is_a & !h2_1

output accept
