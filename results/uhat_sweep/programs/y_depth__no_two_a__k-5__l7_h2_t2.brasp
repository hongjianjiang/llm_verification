alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j & is_a@j & !is_b@j | is_bos@i & !is_a@i & is_b@i & is_bos@j & is_a@j & is_b@j, !is_bos@j)
h1_2 = leftmost(!is_a@i & is_b@i & !is_bos@j & is_a@j | is_a@i & !is_b@i & !is_bos@j & is_a@j & !is_b@j, !is_bos@j | !is_bos@j & is_a@j & !is_b@j)
h2_1 = rightmost(h1_2@i | !h1_2@j, is_b@i & h1_1@i & !is_a@j & is_b@j | !h1_1@i & !is_a@j & is_b@j & h1_1@j)
h2_2 = leftmost(h1_1@i & h1_2@i & !is_bos@j & is_a@j & !is_b@j & h1_1@j & h1_2@j | is_bos@i & !is_a@i & !is_b@i & !h1_1@i & h1_2@i & is_bos@j & is_a@j & !is_b@j & h1_1@j & h1_2@j, h1_1@i & !is_bos@j & !is_b@j & h1_1@j & h1_2@j | h1_1@i & h1_2@i & !is_bos@j & !is_b@j & h1_1@j)
h3_1 = rightmost(h1_1@i & h1_2@i & !h2_1@i & h2_2@i & !is_bos@j & h1_1@j | h1_1@i & h1_2@i & !is_bos@j & h1_1@j & h1_2@j & h2_1@j, !is_bos@j)
h3_2 = leftmost(h1_1@i & !h2_1@i & h2_2@i & !is_bos@j & h1_1@j | h1_1@i & h1_2@i & !h2_1@i & !is_bos@j & h1_1@j & h1_2@j & h2_1@j, h1_2@i | h1_2@i & !h2_2@j)
h4_1 = rightmost(is_bos@i & !is_a@i & is_b@i & !h1_1@i & !h1_2@i & h2_1@i & h2_2@i & !h3_1@i & h3_2@i & is_bos@j & is_a@j & is_b@j & h1_1@j & !h1_2@j & h2_1@j & h2_2@j & h3_2@j | h1_1@i & h2_2@i & h3_1@i & h3_2@i & !is_bos@j & is_a@j & !is_b@j & h1_1@j & h1_2@j & !h2_1@j & h3_1@j & h3_2@j, !is_a@i & is_b@i & h1_1@i & h3_1@i & is_a@j & h3_1@j & h3_2@j | !is_bos@i & h1_1@i & h1_2@i & !h2_1@i & h3_1@i & h3_2@i & !is_bos@j & !is_b@j & h1_1@j & h1_2@j & !h2_1@j & h3_1@j & h3_2@j)
h4_2 = leftmost(h1_1@i & h1_2@i & h3_1@i & h3_2@i & !is_bos@j & h1_1@j & h1_2@j & h2_1@j & h3_2@j | h3_1@i & h3_2@i & !is_bos@j & h1_1@j & h3_1@j, true)
h5_1 = rightmost(h3_1@i & h3_2@i & h4_2@i, true)
h5_2 = leftmost(h1_2@i & h3_1@i & h3_2@i & !h4_1@i & h4_2@i | h3_1@i & h3_2@i & h4_2@i & !is_bos@j, !is_a@i & !is_bos@j | !is_bos@j)
h6_2 = leftmost(!is_a@i & is_b@i & h1_1@i & h1_2@i & h3_1@i & h3_2@i & h4_2@i & !is_bos@j & is_a@j & !is_b@j & h1_1@j & h1_2@j & !h2_1@j & h3_1@j & h3_2@j & h4_2@j | !h2_1@i & h5_1@i & h5_2@i & !is_bos@j & is_a@j & !is_b@j & !h2_1@j & !h4_1@j, !h4_1@j)
h7_1 = rightmost(!is_bos@j & !h4_1@j & h6_2@j | h5_2@i & h6_2@i & !is_bos@j & is_a@j & !is_b@j & !h2_1@j & !h4_1@j, true)
h7_2 = leftmost(h3_1@i & h5_1@i & h6_2@i & !is_bos@j & is_a@j & !is_b@j & h3_1@j & !h4_1@j | h6_2@i & !is_bos@j & is_a@j & !is_b@j & h5_1@j, true)
accept = !h5_2 & !h6_2 & !h7_1 & !h7_2 | !h6_2 & !h7_1 & !h7_2

output accept
