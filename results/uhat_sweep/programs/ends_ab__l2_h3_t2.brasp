alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(true, is_b@i & is_a@j & !is_b@j | !is_a@i & is_b@i & !is_bos@j & is_a@j & !is_b@j)
h1_2 = leftmost(!is_a@i & is_b@i & !is_bos@j & is_a@j & !is_b@j, true)
h1_3 = rightmost(true, is_b@i & !is_bos@j & is_a@j & !is_b@j | !is_a@i & !is_bos@j & is_a@j & !is_b@j)
h2_1 = rightmost(true, h1_1@i & is_a@j & !is_b@j | h1_1@i & h1_3@i & is_a@j)
h2_2 = leftmost(is_a@i & !is_b@i & !h1_1@i & !h1_3@i | is_a@i & !is_b@i & !h1_1@i & !h1_3@i & !is_a@j, is_a@i & !is_b@i & !h1_1@j & !h1_2@j | !is_b@i)
h2_3 = rightmost(!h1_1@i & !h1_3@i, !is_bos@i & !h1_1@i & !h1_3@i | is_a@i & !is_b@i)
accept = !is_a & is_b & h1_1 & h1_3 & !h2_2 & !h2_3 | !is_a & is_b & h1_1 & h1_3 & h2_1 & !h2_2 & !h2_3

output accept
