alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_b@j, !is_a@i & !is_a@j)
h1_2 = leftmost(!is_b@i & !is_bos@j & !is_a@j & is_b@j, true)
h2_1 = rightmost(!is_a@j & is_b@j, !is_a@j & h1_1@j)
h2_2 = leftmost(is_a@i & !is_b@i & !h1_2@i & h1_1@j, is_a@i & !is_b@i & !h1_1@i & !is_bos@j & !is_a@j & is_b@j & h1_1@j)
accept = !is_bos & !h1_1 & h1_2 & !h2_1 & !h2_2

output accept
