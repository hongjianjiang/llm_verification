alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_a@i & !is_bos@j & !is_a@j & is_b@j & !is_c@j, !is_bos@i & !is_bos@j)
h1_2 = leftmost(is_b@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j, true)
h2_2 = leftmost(!h1_2@i & !is_bos@j & !is_c@j & !h1_2@j, !h1_2@i & !is_a@j & !h1_2@j)
accept = h1_1 & !h2_2

output accept
