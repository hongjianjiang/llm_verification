alphabet a b c d

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
is_d = symbol d
h1_1 = rightmost(!is_bos@j & is_a@j & !is_b@j & !is_d@j, !is_bos@j)
h2_1 = rightmost(h1_1@i & !is_bos@j & !is_a@j & is_b@j & h1_1@j, !is_bos@j)
h3_1 = rightmost(!is_a@j & !is_b@j & !is_c@j, !h2_1@j)
h4_1 = rightmost(is_bos@i & !is_a@i & is_b@i & is_d@i & !h1_1@i & !h2_1@i & is_bos@j & !is_a@j & !is_b@j & is_c@j & is_d@j & h1_1@j & !h2_1@j, is_a@i & !is_b@i & is_c@i & is_d@i & !h1_1@i & h2_1@i & !is_c@j & h2_1@j & h3_1@j)
accept = h1_1 & h2_1 & !h3_1 & !h4_1

output accept
