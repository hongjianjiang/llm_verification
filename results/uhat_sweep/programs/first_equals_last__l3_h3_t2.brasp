alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(is_bos@i & !is_a@i & !is_b@i & is_bos@j & is_a@j & !is_b@j | is_bos@i & !is_a@i & is_b@i & !is_bos@j & is_a@j & !is_b@j, is_a@i & !is_b@i & is_a@j & !is_b@j)
h1_2 = leftmost(true, true)
h1_3 = rightmost(true, true)
h2_1 = rightmost(is_bos@i & is_a@i & !is_b@i & h1_1@i & !h1_2@i & !h1_3@i & is_bos@j & !is_a@j & is_b@j & h1_1@j & !h1_2@j & !h1_3@j | is_a@i & !is_b@i & !h1_1@i & !is_bos@j & !is_a@j & is_b@j & !h1_1@j, is_a@i & !is_b@i & h1_2@i & !is_a@j & is_b@j | is_a@i & !is_b@i & h1_2@i & h1_3@i & !is_a@j & is_b@j & !h1_1@j)
h2_2 = leftmost(!is_bos@j | is_a@i & !is_b@i, !is_a@i & is_b@i & is_a@j & !is_b@j | is_bos@i & !is_b@i & !h1_1@i & !h1_2@i & !h1_3@i & is_a@j & !is_b@j & h1_1@j)
h2_3 = rightmost(is_bos@i & is_a@i & !is_b@i & h1_1@i & !h1_2@i & !h1_3@i & is_bos@j & is_b@j & h1_1@j & !h1_2@j & !h1_3@j | is_bos@i & is_a@i & !is_b@i & h1_1@i & !h1_2@i & !h1_3@i & is_bos@j & is_a@j & is_b@j & h1_1@j & !h1_2@j & !h1_3@j, is_bos@i & is_b@i & h1_1@i & !h1_2@i & !h1_3@i & is_b@j & h1_1@j & !h1_2@j & !h1_3@j | is_bos@i & is_a@i & !is_b@i & !h1_2@i & !h1_3@i & is_bos@j & is_a@j & is_b@j & h1_1@j & h1_3@j)
h3_1 = rightmost(!h2_3@i & !is_bos@j & !is_a@j & is_b@j & !h1_1@j & !h2_1@j & !h2_3@j | is_b@i & !h1_1@i & !h1_2@i & !h2_1@i & h2_2@i & h2_3@i & !is_bos@j & !is_a@j & is_b@j & !h1_1@j & !h1_3@j & !h2_1@j & h2_2@j, !is_a@i & is_b@i & !h1_1@i & !h2_1@i & h2_2@i & !h2_3@i & !is_bos@j & !h2_3@j | is_a@i & !is_b@i & !is_a@j & !h2_2@j)
h3_2 = leftmost(is_bos@i & !is_a@i & is_b@i & h1_1@i & !h1_3@i & h2_2@i & is_a@j & is_b@j & h1_1@j & !h1_2@j & !h1_3@j & h2_1@j & h2_2@j & h2_3@j | is_bos@i & !is_a@i & is_b@i & h1_1@i & !h1_2@i & h2_1@i & h2_3@i & is_bos@j & !is_a@j & h1_1@j & !h1_2@j & h1_3@j & h2_1@j & !h2_2@j & h2_3@j, !is_a@i & h1_1@i & !h1_2@i & !h1_3@i & h2_1@i & h2_3@i & is_a@j & h2_2@j & h2_3@j | is_a@i & is_b@i & h1_2@i & !h1_3@i & h2_1@i & h2_2@i & h2_3@i & is_bos@j & h1_1@j & !h1_2@j & !h1_3@j & h2_1@j & h2_3@j)
h3_3 = rightmost(!h2_3@i & !is_bos@j & !is_a@j & is_b@j & !h2_1@j & !h2_2@j | !is_a@i & is_b@i & !h1_1@i & !h2_1@i & !is_bos@j & !is_a@j & is_b@j & !h1_1@j & !h2_1@j & !h2_2@j, is_a@i & !is_b@i & h2_2@i & !h2_2@j | is_a@i & !is_b@i & is_b@j & h1_3@j & !h2_2@j)
accept = !is_bos & !h2_2 & !h3_1 & !h3_2 & !h3_3 | !is_bos & !is_a & is_b & !h2_1 & !h2_2 & !h2_3 & !h3_1

output accept
