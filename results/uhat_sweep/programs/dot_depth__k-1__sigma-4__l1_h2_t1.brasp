alphabet a b c d

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
is_d = symbol d
h1_1 = rightmost(!is_a@i & !is_b@j & !is_c@j & !is_d@j, !is_a@i & !is_a@j)
h1_2 = leftmost(is_bos@i & !is_a@i & is_b@i & is_c@i & is_d@i & is_bos@j & !is_a@j & is_b@j & is_c@j & is_d@j, !is_a@i & is_c@i & is_d@i & is_bos@j & !is_a@j & is_b@j & is_c@j & is_d@j)
accept = !is_bos & !h1_1 & !h1_2

output accept
