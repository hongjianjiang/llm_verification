alphabet 00 01 10 11

is_bos = bos
is_sym0 = symbol 00
is_sym1 = symbol 01
is_sym2 = symbol 10
is_sym3 = symbol 11
h1_1 = rightmost(!is_sym0@i & !is_bos@j & !is_sym0@j & !is_sym1@j & !is_sym2@j & is_sym3@j, !is_sym0@i & !is_sym3@i & !is_bos@j & !is_sym0@j)
h2_1 = rightmost(!is_sym1@i & !is_sym3@i & !is_bos@j & !is_sym0@j & !is_sym1@j & is_sym2@j & !is_sym3@j, !is_sym1@i & !is_sym3@i & !is_bos@j & !is_sym0@j & is_sym2@j)
accept = !is_sym2 & !is_sym3 & !h1_1 & !h2_1

output accept
