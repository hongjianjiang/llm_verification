alphabet marker a b

is_bos = bos
is_marker = symbol marker
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(is_bos@i & !is_marker@i & is_a@i & is_b@i & is_bos@j & is_marker@j & is_a@j & is_b@j, is_bos@i & is_marker@i & is_a@i & is_b@i & is_bos@j & !is_marker@j & is_a@j & is_b@j)
h2_1 = rightmost(!is_bos@j & !h1_1@j, !is_bos@j & is_marker@j & !is_a@j & !h1_1@j)
accept = !is_bos & !h1_1 & h2_1

output accept
