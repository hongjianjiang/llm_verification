alphabet a b c d

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
is_d = symbol d
h1_1 = rightmost(!is_b@i & !is_b@j & !is_c@j & !is_d@j | !is_b@i & is_bos@j & !is_b@j & !is_d@j, !is_a@i & is_d@i & is_bos@j & !is_a@j & is_b@j & !is_c@j | is_bos@j & !is_a@j & !is_b@j & !is_c@j & !is_d@j)
h1_2 = leftmost(!is_bos@j & is_b@j & !is_d@j | is_a@i & is_b@i & is_c@i & !is_d@i & !is_bos@j & is_a@j & is_b@j & is_c@j & is_d@j, true)
h2_1 = rightmost(!h1_1@i & h1_2@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j & !h1_1@j & h1_2@j | is_bos@i & is_a@i & !is_b@i & !is_c@i & !is_d@i & h1_1@i & h1_2@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j & is_d@j & !h1_1@j & h1_2@j, !is_bos@j & !h1_1@j)
h2_2 = leftmost(is_a@i & !is_b@i & !is_d@i & !h1_1@i & h1_2@i & !is_bos@j & !is_b@j & !h1_1@j & h1_2@j | h1_2@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j & !h1_1@j & h1_2@j, !h1_1@j)
h3_1 = rightmost(!h1_1@i & h1_2@i & h2_1@i & h2_2@i & !is_bos@j & !is_b@j & !is_c@j & is_d@j & !h1_1@j & h2_1@j | !is_c@i & !is_d@i & !h1_1@i & h1_2@i & h2_1@i & h2_2@i & !is_bos@j & !is_b@j & is_d@j & !h1_1@j & h1_2@j & h2_1@j, true)
h3_2 = leftmost(!h2_2@i & is_bos@j & is_a@j & is_b@j & is_d@j & h1_1@j & !h1_2@j & !h2_1@j & !h2_2@j | is_bos@i & is_b@i & !is_c@i & h1_1@i & !h1_2@i & h2_1@i & !h2_2@i & !is_a@j & is_b@j & is_c@j & h1_1@j & h2_1@j & !h2_2@j, is_bos@i & !is_a@i & is_b@i & !is_c@i & !is_d@i & h1_1@i & !h1_2@i & !h2_1@i & h2_2@i & is_bos@j & is_c@j & !is_d@j & h2_1@j | is_bos@i & !is_a@i & is_d@i & h1_1@i & h1_2@i & !h2_1@i & !h2_2@i & is_a@j & !is_b@j & is_c@j & !is_d@j & !h1_2@j & h2_1@j & !h2_2@j)
h5_2 = leftmost(!h3_2@i & !is_bos@j & !is_c@j & !h3_2@j | !is_c@i & !h2_2@i & !h3_1@i, !h3_1@i & !h3_2@i & !h3_2@j | !h3_1@i & !h3_2@i & !is_a@j & !h3_1@j)
accept = h1_2 & h2_1 & h2_2 & h3_1 & !h3_2 | !is_d & h2_1 & h2_2 & !h5_2

output accept
