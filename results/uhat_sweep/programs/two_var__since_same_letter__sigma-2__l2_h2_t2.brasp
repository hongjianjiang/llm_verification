alphabet marker a b

is_bos = bos
is_marker = symbol marker
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_a@i & is_marker@j & !is_b@j | !is_b@i & !is_a@j, !is_bos@j & is_marker@j & !is_a@j & !is_b@j)
h1_2 = leftmost(!is_bos@j & is_marker@j & !is_a@j & !is_b@j, true)
h2_1 = rightmost(!is_a@i & is_a@j & !is_b@j | !is_a@i & !is_b@j, !is_a@i & !is_marker@j & is_a@j & h1_2@j | is_bos@i & is_marker@i & !is_a@i & is_b@i & !h1_1@i & !h1_2@i & !is_marker@j & is_a@j & is_b@j)
h2_2 = leftmost(true, !is_marker@i & h1_1@i & h1_2@i & !h1_1@j & !h1_2@j | !is_marker@i & h1_1@i & h1_2@i & !h1_2@j)
accept = h1_1 & h1_2 & !h2_1 | !is_marker & h1_1 & h1_2 & !h2_1 & h2_2

output accept
