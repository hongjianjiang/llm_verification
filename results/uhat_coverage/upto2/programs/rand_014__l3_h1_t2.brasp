alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(true, !is_bos@j & !is_a@j & is_b@j | !is_a@i & !is_a@j & is_b@j)
h2_1 = rightmost(true, !is_bos@j & h1_1@j | !is_a@i & is_b@i)
h3_1 = rightmost(true, !is_a@i & is_b@i | !is_bos@j & !is_a@j & is_b@j & h1_1@j)
accept = !is_bos & is_a & !is_b & !h2_1 & !h3_1 | !is_bos & is_a & !h2_1 & !h3_1

output accept
