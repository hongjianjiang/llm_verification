alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(is_bos@i & is_a@i & !is_b@i & is_bos@j & is_a@j & is_b@j, !is_a@i & is_b@i & is_a@j & !is_b@j)
h2_1 = rightmost(is_bos@i & !is_a@i & is_b@i & h1_1@i & is_bos@j & is_a@j & is_b@j & h1_1@j, is_bos@i & is_a@i & !is_b@i & h1_1@i & is_bos@j & is_a@j & is_b@j & h1_1@j)
h3_1 = rightmost(is_bos@i & is_a@i & is_b@i & h1_1@i & h2_1@i & is_bos@j & is_a@j & is_b@j & h1_1@j & h2_1@j, is_bos@i & !is_a@i & !is_b@i & h1_1@i & is_a@j & is_b@j & h1_1@j & h2_1@j)
h4_1 = rightmost(!h2_1@i, !h2_1@i & !h3_1@i & !is_bos@j & !is_a@j & is_b@j & !h1_1@j & !h2_1@j)
h5_1 = rightmost(!is_bos@j, !h4_1@i & !is_bos@j & is_a@j & !is_b@j)
h6_1 = rightmost(!h3_1@i & !is_bos@j & !h1_1@j, !h2_1@i & !h3_1@i & !h4_1@i & !is_bos@j & is_a@j & !is_b@j & !h2_1@j)
h9_1 = rightmost(!h5_1@i & !h6_1@i & !is_bos@j & is_a@j & !is_b@j & !h4_1@j & !h5_1@j & !h6_1@j, !h5_1@i & !h6_1@i & !is_bos@j & is_a@j & !is_b@j & !h1_1@j & !h4_1@j)
accept = !h3_1 & h4_1 & !h5_1 & !h6_1 & !h9_1

output accept
