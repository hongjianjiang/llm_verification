alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(true, !is_b@j)
h2_1 = rightmost(!h1_1@i & !is_bos@j & !is_a@j & is_b@j & !is_c@j, !h1_1@i & !is_bos@j & !is_a@j & is_b@j & !is_c@j)
h3_1 = rightmost(!h1_1@i & h2_1@i & is_b@j & !is_c@j & !h2_1@j, !h1_1@i)
accept = h1_1 & !h2_1 & !h3_1

output accept
