alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_a@i & is_b@i & !is_bos@j & !is_a@j & is_b@j, is_b@i)
h2_1 = rightmost(!is_a@i & is_b@i & h1_1@i & !is_bos@j & !is_a@j & is_b@j | !is_a@i & is_b@i & h1_1@i & !is_bos@j & !is_a@j, !is_a@i)
h3_1 = rightmost(!is_a@i & is_b@i & h1_1@i & h2_1@i | !is_a@i & is_b@i & h1_1@i & h2_1@i & !is_bos@j & !is_a@j & is_b@j, !is_a@i & is_b@i | h1_1@i)
accept = !is_a & is_b & h1_1 & h2_1 | !is_a & h2_1 & h3_1

output accept
