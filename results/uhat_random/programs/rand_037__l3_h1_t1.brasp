alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_b@i & !is_bos@j & !is_a@j & is_b@j & !is_c@j, !is_b@i & !is_bos@j)
h2_1 = rightmost(!is_a@i & !h1_1@i & is_bos@j & !is_a@j & !is_c@j & !h1_1@j, !is_a@i & !h1_1@i & !h1_1@j)
accept = !is_bos & !is_b & !h2_1

output accept
