alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_b@j, !is_a@i & is_b@i & is_bos@j & !is_a@j & !is_b@j | is_bos@i & !is_a@i & is_b@i & is_bos@j & !is_a@j & is_b@j)
h1_2 = leftmost(is_a@i & !is_b@i & !is_bos@j & is_a@j & !is_b@j, is_a@i & !is_b@i | is_a@i & !is_b@j)
h2_2 = leftmost(is_bos@i & !is_a@i & is_b@i & h1_1@i & !h1_2@i & is_bos@j & !is_a@j & is_b@j & h1_1@j & h1_2@j | !is_a@i & is_b@i, !is_a@i & is_b@i & is_bos@j | !is_a@i & !h1_2@i & !h1_1@j)
accept = is_a & !is_b & h1_2 & !h2_2 | is_a & !is_b & h1_2

output accept
