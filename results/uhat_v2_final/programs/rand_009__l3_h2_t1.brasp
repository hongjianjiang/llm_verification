alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_a@i & is_b@i & !is_bos@j, !is_a@i & is_b@i & !is_bos@j)
h1_2 = leftmost(true, is_b@i)
h2_1 = rightmost(!is_a@i & is_b@i & h1_1@i & is_b@j & h1_1@j, !is_a@i & !is_bos@j)
h2_2 = leftmost(!h1_1@i & !is_bos@j & !is_a@j & h1_1@j & h1_2@j, !h1_1@i & !h1_2@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j)
h3_2 = leftmost(!h2_1@i & !is_bos@j & !is_a@j & is_b@j & !h2_2@j, !h2_1@i & !is_bos@j & !is_a@j & is_b@j)
accept = !is_bos & !h3_2

output accept
