alphabet 0 1

is_bos = bos
is_sym0 = symbol 0
is_sym1 = symbol 1
h1_1 = rightmost(true, !is_sym0@j & is_sym1@j)
h2_1 = rightmost(is_sym1@i & !is_bos@j, !h1_1@i & !is_bos@j & is_sym0@j & !is_sym1@j)
h3_1 = rightmost(!is_sym0@j & is_sym1@j & !h2_1@j, !is_sym1@i & !is_sym0@j & is_sym1@j & !h1_1@j)
accept = is_sym0 & !is_sym1 & h1_1 & !h2_1 & h3_1

output accept
