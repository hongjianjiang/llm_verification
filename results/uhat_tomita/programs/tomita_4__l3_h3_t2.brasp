alphabet 0 1

is_bos = bos
is_sym0 = symbol 0
is_sym1 = symbol 1
h1_1 = rightmost(is_sym0@i & !is_sym1@i & !is_bos@j | !is_bos@j & !is_sym0@j & is_sym1@j, is_sym0@j & !is_sym1@j)
h1_2 = leftmost(true, true)
h1_3 = rightmost(true, true)
h2_1 = rightmost(is_sym0@i & h1_1@i & is_sym0@j & !is_sym1@j & h1_1@j | is_sym0@i & !is_sym1@i & h1_1@i & h1_2@i & !is_bos@j & h1_2@j, h1_1@i & is_sym0@j & !is_sym1@j & h1_1@j | is_sym0@j & !is_sym1@j & h1_1@j)
h2_2 = leftmost(!is_sym0@i & is_sym1@i & h1_1@i & !h1_3@i & !is_bos@j & is_sym0@j & is_sym1@j & h1_1@j & !h1_2@j & !h1_3@j | is_bos@i & !is_sym0@i & !is_sym1@i & h1_1@i & !h1_2@i & !h1_3@i & !is_bos@j & is_sym0@j & !is_sym1@j & h1_1@j & !h1_2@j & !h1_3@j, is_sym0@j & !is_sym1@j & h1_1@j | !is_sym1@j)
h2_3 = rightmost(is_sym0@i & !is_sym1@i & h1_1@i & !is_bos@j & h1_2@j | is_sym0@i & h1_1@i & !is_bos@j & is_sym0@j & !is_sym1@j & h1_2@j, !is_bos@i & h1_2@i & !is_bos@j & is_sym0@j & !is_sym1@j & h1_1@j & h1_2@j | h1_2@i & !is_bos@j & is_sym0@j & !is_sym1@j & h1_1@j)
h3_2 = leftmost(!is_bos@j & is_sym0@j & !is_sym1@j & h1_1@j & h2_1@j & h2_3@j | !is_bos@j & is_sym0@j & h1_1@j & h2_1@j & h2_3@j, !is_bos@j & is_sym0@j & !is_sym1@j | h1_2@i & !is_bos@j & !is_sym1@j)
h3_3 = rightmost(!is_bos@j & is_sym0@j & !is_sym1@j & h1_1@j & h2_1@j & h2_2@j & h2_3@j | h1_2@i & h2_1@i & !is_bos@j & is_sym0@j & !is_sym1@j & h1_1@j & h1_2@j & h2_3@j, is_sym0@j & !is_sym1@j & h1_1@j | h2_1@i & is_sym0@j & h1_1@j & h2_2@j & h2_3@j)
accept = !h2_1 & !h2_2 & !h2_3 & !h3_2 & !h3_3

output accept
