alphabet 0 1

is_bos = bos
is_sym0 = symbol 0
is_sym1 = symbol 1
h1_1 = rightmost(is_sym0@i & !is_sym1@i | !is_sym0@j, !is_sym0@j | !is_sym0@j & is_sym1@j)
h2_1 = rightmost(is_sym0@i & !is_sym1@i & !h1_1@i & !is_bos@j | is_sym0@i & !is_sym1@i & !h1_1@i & !is_bos@j & !h1_1@j, !h1_1@i & !is_bos@j & is_sym0@j & !is_sym1@j & !h1_1@j | !h1_1@i & is_sym0@j & !is_sym1@j & !h1_1@j)
h3_1 = rightmost(!is_bos@j & is_sym0@j & !is_sym1@j & !h1_1@j & h2_1@j | is_sym0@i & !is_sym1@i & !h1_1@i & h2_1@i & !is_bos@j & is_sym0@j & !is_sym1@j & !h1_1@j, !h1_1@i & h2_1@i & !is_bos@j & is_sym0@j & !is_sym1@j & !h1_1@j | is_sym0@j & !h1_1@j & h2_1@j)
h4_1 = rightmost(h3_1@i & !is_bos@j & is_sym0@j & !is_sym1@j & !h1_1@j, is_sym0@j & !is_sym1@j | !is_sym1@j)
accept = !h2_1 & !h3_1 & !h4_1

output accept
