alphabet 0 1

is_bos = bos
is_sym0 = symbol 0
is_sym1 = symbol 1
h1_1 = rightmost(is_bos@i & !is_sym0@i & is_sym1@i & is_bos@j & is_sym0@j & is_sym1@j | is_sym0@i & !is_sym1@i & !is_bos@j & !is_sym0@j & is_sym1@j, is_sym0@i & !is_bos@j & !is_sym0@j & is_sym1@j | is_sym0@i & !is_bos@j & is_sym1@j)
h1_2 = leftmost(true, true)
h1_3 = rightmost(true, is_sym0@j & !is_sym1@j)
h2_1 = rightmost(is_bos@i & is_sym0@i & is_sym1@i & h1_1@i & !h1_2@i & !h1_3@i & is_bos@j & is_sym0@j & is_sym1@j & h1_1@j & !h1_2@j & h1_3@j | is_bos@i & is_sym0@i & !is_sym1@i & h1_1@i & !h1_2@i & !h1_3@i & !is_bos@j & !is_sym0@j & is_sym1@j & h1_1@j & !h1_2@j & h1_3@j, is_sym0@i & h1_1@i & !h1_2@i & is_bos@j & !is_sym0@j & is_sym1@j & h1_3@j | is_sym0@i & h1_1@i & !h1_2@i & h1_3@i & is_bos@j & !is_sym0@j & is_sym1@j & h1_3@j)
h2_2 = leftmost(!is_bos@j & is_sym0@j & h1_1@j & h1_2@j | is_bos@i & is_sym0@i & !is_sym1@i & h1_1@i & !h1_2@i & !h1_3@i & !is_bos@j & is_sym0@j & is_sym1@j & h1_1@j & !h1_2@j & h1_3@j, true)
h2_3 = rightmost(!is_bos@j & !is_sym0@j & is_sym1@j & h1_3@j | !is_sym0@i & is_sym1@i & h1_1@i & !is_sym0@j & is_sym1@j & h1_1@j & h1_2@j, !is_bos@i & !is_bos@j | !is_bos@j & h1_3@j)
h3_3 = rightmost(is_sym0@i & !is_sym1@i & h1_1@i & !h1_3@i & h2_2@i & h2_3@i & !is_bos@j & !is_sym0@j & is_sym1@j & h1_3@j & h2_2@j | is_sym0@i & !is_sym1@i & h1_1@i & h2_2@i & !is_bos@j & !is_sym0@j & is_sym1@j & h1_2@j & h1_3@j & h2_2@j, is_sym0@i & h2_2@j | !is_sym1@i & !is_bos@j & h2_2@j)
h4_2 = leftmost(h2_2@i & !is_bos@j & h1_2@j & h2_2@j & h3_3@j | is_sym0@i & !is_sym1@i & h1_1@i & h2_2@i & h3_3@i & !is_bos@j & h1_2@j, !is_bos@j & h3_3@j | h3_3@i)
h4_3 = rightmost(is_sym0@i & !is_sym1@i & h1_1@i & h2_2@i & h3_3@i & !is_bos@j | !is_sym0@i & !is_bos@j & is_sym0@j & !is_sym1@j & h1_2@j & h3_3@j, !is_bos@j)
accept = !h2_1 & !h3_3 & !h4_2 & !h4_3

output accept
