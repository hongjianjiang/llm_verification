alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j & is_a@j & !is_b@j | !is_bos@j, !is_bos@j & is_a@j & !is_b@j | is_a@i & !is_b@i & !is_bos@j)
h1_2 = leftmost(!is_b@j | !is_a@j, !is_a@i & is_b@i & !is_a@j)
h1_3 = rightmost(true, !is_a@i & is_b@i)
h2_1 = rightmost(is_a@i & !is_b@i & h1_1@i & !is_a@j & is_b@j & h1_2@j | h1_1@i & !is_bos@j & !is_a@j & is_b@j & !h1_1@j & h1_2@j & h1_3@j, !is_bos@j & is_b@j)
h2_2 = leftmost(is_bos@i & is_b@i & h1_1@i & h1_2@i & !h1_3@i & !is_bos@j & is_a@j & !is_b@j & h1_1@j & h1_2@j & h1_3@j | is_a@i & !is_b@i & h1_1@i & !is_bos@j & is_b@j & h1_2@j & h1_3@j, true)
h2_3 = rightmost(h1_1@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j | is_a@i & !is_b@i & h1_1@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j & h1_3@j, !is_bos@i & h1_1@i & !is_bos@j & is_b@j | is_a@i & !is_b@i & !is_bos@j & !is_a@j & is_b@j)
h3_1 = rightmost(!is_a@i & is_b@i & is_a@j & !is_b@j & !h1_2@j & h2_1@j & h2_3@j | !is_a@i & is_b@i & !h2_2@i & !is_bos@j & !h1_2@j & !h1_3@j & h2_3@j, !is_a@i & h2_1@j | is_b@i)
h3_2 = leftmost(h2_1@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j & h1_3@j & h2_1@j & !h2_2@j | h1_1@i & h2_3@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j & h1_3@j, !is_a@j & is_b@j | !is_bos@j & is_b@j)
h3_3 = rightmost(is_a@i & !is_b@i & h1_1@i & !h1_3@i & h2_1@i & h2_3@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j & h1_3@j | is_a@i & !is_b@i & h1_1@i & h2_1@i & h2_3@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j & h1_3@j, true)
accept = !h2_1 & !h2_3 & !h3_1 & !h3_2 & !h3_3 | !h2_1 & !h2_2 & !h2_3 & !h3_1 & !h3_2 & !h3_3

output accept
