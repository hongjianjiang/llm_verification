alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j & is_a@j & !is_b@j, is_a@j & !is_b@j | !is_bos@j & is_a@j & !is_b@j)
h1_2 = leftmost(!is_bos@j & is_a@j, is_a@j & !is_b@j)
h1_3 = rightmost(!is_bos@j & is_a@j & !is_b@j, !is_bos@j & is_a@j)
h2_2 = leftmost(!is_bos@j & is_b@j & !h1_1@j | !is_bos@j & is_b@j, !is_a@j & is_b@j & !h1_1@j & !h1_2@j & !h1_3@j)
h2_3 = rightmost(!is_bos@j & !is_a@j & is_b@j & !h1_1@j & !h1_2@j & !h1_3@j | !is_a@i & is_b@i & !h1_1@i & !h1_3@i & !is_a@j & !h1_1@j & !h1_2@j & !h1_3@j, !is_bos@i & !h1_2@j | !h1_1@j)
accept = !is_bos & h1_1 & h1_2 & !h2_2 & !h2_3 | !is_bos & !h2_2 & !h2_3

output accept
