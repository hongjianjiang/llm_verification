alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(is_a@i & !is_b@i | is_a@i & !is_b@i & !is_b@j, is_a@i)
h1_3 = rightmost(is_a@i & !is_b@i & !is_b@j | is_a@i & !is_b@i & is_bos@j & !is_a@j & !is_b@j, is_a@i | !is_b@i)
accept = is_a & !is_b & h1_1 & h1_3 | is_a & !is_b & h1_3

output accept
