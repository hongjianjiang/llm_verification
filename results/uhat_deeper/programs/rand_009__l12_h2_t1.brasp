alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_a@i & !is_b@i & is_c@i & is_bos@j & !is_a@j & !is_b@j & !is_c@j, !is_a@i & !is_b@i & is_c@i & is_bos@j & !is_a@j & !is_b@j & !is_c@j)
h1_2 = leftmost(is_bos@i & is_a@i & !is_b@i & is_c@i & is_bos@j & is_a@j & !is_b@j & is_c@j, is_bos@i & is_a@i & !is_b@i & is_c@i & is_bos@j & is_a@j & is_b@j & is_c@j)
h2_1 = rightmost(is_a@i & is_b@i & is_c@i & h1_1@i & h1_2@i & is_bos@j & !is_a@j & !is_b@j & is_c@j & h1_2@j, is_bos@i & is_a@i & h1_2@i & is_a@j & is_b@j & is_c@j & h1_1@j & h1_2@j)
h2_2 = leftmost(is_a@i & !is_b@i & is_c@i & h1_1@i & h1_2@i & is_a@j & is_b@j & h1_1@j, is_bos@i & !is_a@i & is_b@i & h1_1@i & is_bos@j & is_b@j & h1_2@j)
h3_1 = rightmost(is_bos@i & is_b@i & h1_1@i & h1_2@i & h2_2@i & is_bos@j & is_a@j & h1_2@j & h2_1@j & h2_2@j, is_bos@i & is_c@i & h1_2@i & h2_1@i & is_a@j & is_c@j)
h3_2 = leftmost(is_a@i & h1_2@i & h2_2@i & is_bos@j & !is_a@j & is_b@j & h2_2@j, is_bos@i & h1_1@i & h2_2@i & !is_bos@j & is_a@j & !is_b@j & h1_2@j & h2_1@j)
h4_1 = rightmost(!is_a@i & h1_1@i & h3_2@i & is_a@j & h1_2@j, is_a@j & is_c@j & h2_2@j & h3_2@j)
h4_2 = leftmost(is_c@i & h2_1@i & h2_2@i & is_bos@j & is_b@j & !h3_1@j & h3_2@j, !is_a@i & h1_1@i & h2_1@i & h3_1@i & h3_2@i & is_a@j & !is_b@j & h1_1@j & h3_1@j)
h5_1 = rightmost(!is_a@i & h2_1@i & h4_2@i & is_bos@j & h1_1@j & h2_1@j & h2_2@j & h3_2@j, h3_2@i & h4_1@i & is_a@j)
h5_2 = leftmost(!is_a@i & is_c@i & h2_1@i & h4_1@i & !is_a@j & is_b@j & !is_c@j & h1_1@j & h1_2@j, is_bos@i & h3_2@i & is_a@j & h2_1@j & h3_1@j)
h6_1 = rightmost(is_bos@i & is_c@i & h1_1@i & h3_2@i & is_c@j & h2_2@j & h3_2@j & h4_1@j & h5_1@j, h2_1@i & h2_2@i & h3_2@i & h4_1@i & h5_1@i & is_a@j & h2_2@j & h3_1@j)
h6_2 = leftmost(h2_1@i & h1_2@j & h2_2@j & h5_1@j, h1_2@i & h3_1@i & h5_1@i & is_a@j & h2_1@j & h2_2@j & h4_2@j & h5_2@j)
h7_2 = leftmost(h2_1@i & h6_1@i & is_a@j & h4_1@j & h5_2@j & h6_2@j, h2_1@i & h5_2@i & h4_2@j)
h8_1 = rightmost(h3_1@j & h4_2@j & h7_2@j, is_c@i & h1_2@i & h5_1@i & h6_1@j & h7_2@j)
h10_1 = rightmost(!h5_1@j, !h4_1@i & !is_b@j & !h6_2@j & !h8_1@j)
accept = !is_bos & !is_c & !h1_1 & !h1_2 & !h2_2 & !h10_1

output accept
