alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(true, !is_bos@j & !is_a@j & is_b@j)
h1_2 = leftmost(!is_bos@j, !is_bos@j & !is_a@j & is_b@j)
h2_1 = rightmost(is_bos@i & is_a@i & !is_b@i & h1_1@i & !h1_2@i & is_bos@j & is_a@j & !is_b@j & !h1_1@j & h1_2@j | h1_1@i & !h1_2@i & !is_bos@j & h1_1@j & !h1_2@j, !is_bos@i & h1_1@i & !h1_2@i | h1_1@i & !h1_2@i & is_a@j & !is_b@j & !h1_2@j)
h2_2 = leftmost(!h1_1@i & !is_bos@j & is_a@j | h1_1@i & !is_bos@j & is_b@j, true)
h3_1 = rightmost(is_bos@i & !is_a@i & !is_b@i & h1_1@i & !h1_2@i & h2_1@i & !h2_2@i & is_bos@j & !h1_1@j & h1_2@j & h2_1@j & !h2_2@j | is_bos@i & !is_a@i & !is_b@i & h1_1@i & !h1_2@i & h2_1@i & !h2_2@i & !is_bos@j & is_a@j & !is_b@j & !h1_1@j & !h1_2@j & h2_1@j & !h2_2@j, !is_a@i & h1_1@i & !h1_2@i & !h2_1@i & !h2_2@i & is_a@j & h1_2@j & h2_1@j & !h2_2@j | is_a@i & is_b@i & !h1_1@i & !h2_2@i & is_bos@j & is_b@j & !h1_1@j & h1_2@j & h2_1@j)
h3_2 = leftmost(is_bos@i & is_a@i & is_b@i & h1_1@i & !h1_2@i & !h2_1@i & !h2_2@i & is_bos@j & is_a@j & is_b@j & !h1_1@j & h1_2@j & h2_1@j & h2_2@j | is_bos@i & is_a@i & is_b@i & !h1_1@i & h1_2@i & h2_1@i & !h2_2@i & is_bos@j & !is_a@j & !is_b@j & !h1_1@j & h1_2@j & h2_1@j & h2_2@j, is_bos@i & !is_a@i & is_b@i & !h1_1@i & h1_2@i & h2_1@i & !h2_2@i & !is_a@j & is_b@j & !h1_1@j & h2_1@j & h2_2@j | is_bos@i & !is_b@i & !h1_1@i & h1_2@i & h2_1@i & !h2_2@i & is_bos@j & !is_a@j & !h1_1@j & h1_2@j & h2_2@j)
h4_2 = leftmost(!h2_1@i & !is_bos@j & !h1_1@j & !h2_1@j & h2_2@j | !h1_1@i & !is_bos@j & h1_1@j & h1_2@j & !h2_1@j, !h2_1@i & !is_a@j & is_b@j & !h2_1@j & !h3_1@j | h1_2@i & !h2_1@i & !is_a@j & is_b@j & h1_2@j & !h2_1@j)
h5_1 = rightmost(!h1_1@i & !h2_1@i & h2_2@j | h1_2@i & !h2_1@i & !is_bos@j & h1_1@j & h1_2@j, !h2_1@i & !h3_1@i & !is_bos@j & h1_1@j | !h2_1@i & !is_bos@j & h2_2@j)
h6_1 = rightmost(!h2_1@i & h4_2@i & !is_bos@j & h2_2@j | !h1_1@i & !h2_1@i & !is_bos@j & h2_2@j, !h2_1@i & !h3_1@j | !h2_1@i & !h3_2@i & h1_1@j & !h3_1@j)
h9_1 = rightmost(h1_2@i & !h2_1@i & !is_bos@j & h1_2@j & h2_2@j | !h2_1@i & h2_2@i & h6_1@i & !is_bos@j & h2_2@j, h2_2@i & !is_bos@j & h2_2@j | !is_bos@i & !is_bos@j & h2_2@j)
accept = !is_bos & h2_2 & !h3_2 & !h5_1 & !h6_1 & !h9_1

output accept
