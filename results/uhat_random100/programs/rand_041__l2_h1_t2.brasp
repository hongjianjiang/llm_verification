alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_a@i & is_b@i & !is_b@j, is_bos@j & !is_a@j | is_bos@i & is_bos@j & !is_a@j & is_b@j)
h2_1 = rightmost(is_a@i & !is_b@i & !h1_1@i & !is_bos@j & !is_a@j & is_b@j & h1_1@j | is_bos@i & is_a@i & !is_b@i & !h1_1@i & !is_bos@j & !is_a@j & is_b@j & h1_1@j, !is_b@i & !is_bos@j)
accept = is_a & !is_b & h2_1 | !is_bos & is_a & !h1_1 & h2_1

output accept
