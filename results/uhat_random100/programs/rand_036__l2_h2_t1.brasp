alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_b@j, is_bos@j & !is_a@j & !is_c@j)
h1_2 = leftmost(!is_bos@j, !is_b@i & !is_bos@j & !is_a@j & is_b@j & !is_c@j)
h2_1 = rightmost(!h1_2@i & !is_bos@j & !is_b@j & !h1_2@j, !is_bos@j)
h2_2 = leftmost(!is_bos@j, !is_b@j & !h1_2@j)
accept = !is_bos & !h1_1 & h2_1 & h2_2

output accept
