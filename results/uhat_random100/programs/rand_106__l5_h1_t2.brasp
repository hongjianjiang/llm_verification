alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(true, true)
h2_1 = rightmost(true, true)
h3_1 = rightmost(true, true)
h4_1 = rightmost(is_bos@i & !is_a@i & is_b@i & h1_1@i & !h2_1@i & !h3_1@i & is_bos@j & !is_a@j & is_b@j & !h1_1@j & !h2_1@j & h3_1@j | !is_a@i & h1_1@i & !h2_1@i & h3_1@i & !is_bos@j & is_a@j & is_b@j & h2_1@j & !h3_1@j, is_bos@i & is_a@i & is_b@i & !h2_1@i & !h3_1@i & is_bos@j & !is_a@j & !is_b@j & !h1_1@j & !h2_1@j & h3_1@j | is_bos@i & is_a@i & h1_1@i & !h2_1@i & h3_1@i & is_bos@j & !is_a@j & !is_b@j & !h1_1@j & h2_1@j & !h3_1@j)
h5_1 = rightmost(true, true)
accept = is_bos & is_a & !is_b & !h1_1 & !h2_1 & !h3_1 & h4_1 & !h5_1 | is_bos & is_a & is_b & !h1_1 & !h2_1 & !h3_1 & h4_1 & !h5_1

output accept
