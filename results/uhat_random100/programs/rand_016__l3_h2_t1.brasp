alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(true, !is_b@j)
h1_2 = leftmost(is_a@i & !is_b@i & !is_bos@j, true)
h2_1 = rightmost(!is_bos@j & !h1_1@j, !is_a@j & is_b@j & !h1_1@j)
h2_2 = leftmost(h1_1@i & !is_bos@j & !is_a@j & is_b@j & !h1_1@j, !is_b@i & h1_1@i & !is_bos@j & !is_a@j & is_b@j & h1_2@j)
h3_1 = rightmost(h2_1@i & !is_bos@j & !is_a@j & is_b@j, !is_a@j & is_b@j)
h3_2 = leftmost(h1_1@i & h2_1@i & !h2_2@j, true)
accept = !is_bos & !h2_1 & !h2_2 & !h3_1 & !h3_2

output accept
