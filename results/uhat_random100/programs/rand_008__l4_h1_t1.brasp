alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(is_a@i & !is_b@i, is_a@i & !is_b@i & !is_a@j & is_b@j)
h2_1 = rightmost(!is_bos@j & is_a@j & !is_b@j, !h1_1@i & !is_bos@j & is_a@j)
h4_1 = rightmost(is_a@i & !is_b@i, !is_b@i & !is_a@j & is_b@j & !h1_1@j)
accept = !is_bos & h2_1 & !h4_1

output accept
