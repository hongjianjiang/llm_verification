alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_a@i & !is_b@i & is_c@i & !is_bos@j, !is_b@i & is_a@j & !is_b@j & !is_c@j)
h2_1 = rightmost(true, !h1_1@i & !h1_1@j)
h3_1 = rightmost(!is_bos@j & !is_c@j, !h2_1@i & !is_bos@j & is_a@j & !is_b@j & !is_c@j)
accept = !is_bos & !h1_1 & !h3_1

output accept
