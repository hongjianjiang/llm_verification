alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_a@i & !is_a@j & !is_b@j & is_c@j | !is_a@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j, !is_a@i & is_c@i & !is_bos@j | !is_a@i & !is_bos@j & !is_b@j & is_c@j)
h1_2 = leftmost(!is_c@i & !is_bos@j, !is_c@i)
h2_1 = rightmost(!is_c@i & !h1_1@i & h1_2@i & !h1_1@j | is_a@i & !h1_1@i & h1_2@i & !is_bos@j, !h1_1@i & !is_bos@j | !is_c@i)
h2_2 = leftmost(!is_a@i & is_b@i & h1_1@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j | !is_a@i & is_c@i & h1_1@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j & !h1_2@j, !is_a@i & h1_1@i & !is_b@j & !h1_2@j | !is_a@i & h1_1@i & !is_b@j)
h3_2 = leftmost(!is_a@i & is_b@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j | !is_a@i & !is_bos@j & !is_a@j & !is_b@j & is_c@j & !h1_2@j, !is_a@i & !is_b@j | !is_a@i & !is_a@j & !is_b@j)
accept = !is_c & !h1_1 & h1_2 & !h2_2 & !h3_2 | !is_c & !h1_1 & h1_2 & h2_1 & !h2_2 & !h3_2

output accept
