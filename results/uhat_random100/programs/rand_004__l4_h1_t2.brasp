alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j, is_a@j & !is_b@j | !is_bos@j & is_a@j & !is_b@j)
h2_1 = rightmost(true, !h1_1@i & !is_a@j)
h3_1 = rightmost(!is_bos@j, h1_1@i & is_a@j & !is_b@j | h1_1@i & is_a@j)
h4_1 = rightmost(!h1_1@i & h2_1@i & !h3_1@i & !is_a@j | !is_a@i & is_b@i & !is_bos@j & !is_a@j & is_b@j, !is_a@j)
accept = h1_1 & !h4_1 | h1_1 & !h2_1 & h3_1 & !h4_1

output accept
