alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_b@i, !is_b@i & is_a@j & !is_c@j | !is_c@j)
h2_1 = rightmost(!is_a@i & is_b@i & !is_c@i & !h1_1@i | !h1_1@i & !is_a@j & is_c@j, !h1_1@i)
h2_2 = leftmost(!h1_1@i & !is_a@j & !is_b@j | !is_a@i & is_b@i & !is_c@i & !h1_1@i & !is_a@j & !is_b@j, !is_a@i & is_b@i & !is_c@i | !h1_1@i & !is_b@j)
accept = !is_bos & !is_b & h1_1 & !h2_1 & !h2_2 | !is_b & h1_1 & !h2_1 & !h2_2

output accept
