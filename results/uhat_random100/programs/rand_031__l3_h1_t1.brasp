alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(is_a@i & !is_b@i & !is_bos@j & !is_a@j & is_b@j, !is_bos@j)
h2_1 = rightmost(!is_bos@j & is_a@j & !is_b@j & !h1_1@j, is_a@j & !is_b@j & !h1_1@j)
h3_1 = rightmost(is_a@i & !h2_1@i & !is_bos@j & !is_b@j & h1_1@j & !h2_1@j, !is_b@i & !h2_1@i & !is_bos@j & !h2_1@j)
accept = is_a & !is_b & h1_1 & !h2_1 & h3_1

output accept
