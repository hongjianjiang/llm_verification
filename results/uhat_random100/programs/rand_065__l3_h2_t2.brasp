alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j, is_a@j & !is_b@j | is_a@i & !is_b@i & !is_bos@j)
h2_1 = rightmost(!is_b@i & h1_1@i & !is_bos@j | h1_1@i, true)
h2_2 = leftmost(h1_1@i | is_a@i & !is_b@i & h1_1@i & !is_bos@j, true)
h3_1 = rightmost(!is_a@i & is_b@i & !h1_1@i & !h2_2@i & !is_a@j | !h1_1@i & !h2_1@i & !h2_2@i & !is_a@j, !is_a@i & !h1_1@i & !is_a@j | !h1_1@i & !is_a@j)
h3_2 = leftmost(h1_1@i | h1_1@i & !is_bos@j, is_a@i & !is_b@i | h1_1@i)
accept = h1_1 & !h3_1 & h3_2

output accept
