alphabet a b

is_bos = bos
is_a = symbol a
is_b = symbol b
h1_1 = rightmost(!is_bos@j, !is_bos@j & !is_a@j & is_b@j)
h2_1 = rightmost(!is_bos@j, !is_bos@j & is_a@j & !is_b@j & h1_1@j)
h3_1 = rightmost(h2_1@i & !is_bos@j & !is_a@j & is_b@j, h2_1@i & !is_bos@j)
h4_1 = rightmost(!h2_1@i & !is_b@j & !h2_1@j & !h3_1@j, !is_b@j & !h2_1@j & !h3_1@j)
accept = !is_bos & h2_1 & h3_1 & !h4_1

output accept
