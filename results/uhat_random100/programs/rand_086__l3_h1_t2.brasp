alphabet a b c

is_bos = bos
is_a = symbol a
is_b = symbol b
is_c = symbol c
h1_1 = rightmost(!is_b@i | !is_bos@j & is_b@j & !is_c@j, true)
h2_1 = rightmost(is_b@i & !is_c@i & !is_bos@j & !is_c@j | !is_c@i & !is_bos@j & !is_c@j, is_b@i & !is_bos@j | !is_c@i & !is_bos@j)
h3_1 = rightmost(!is_a@i & !h2_1@i & !is_a@j & !is_b@j & !h2_1@j | !is_a@i & !h2_1@i & is_bos@j & !is_a@j & !is_b@j & !h1_1@j & !h2_1@j, !h2_1@i | !is_a@i & !h2_1@i & !is_a@j & !is_b@j)
accept = !is_a & is_c & !h2_1 | !is_bos & !is_a & !h2_1 & h3_1

output accept
