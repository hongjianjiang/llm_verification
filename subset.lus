node kind2_subset(symbol: int) returns (bad: bool; empty_bad: bool);
con
  assume 0 <= symbol and symbol < 2;
  guarantee not bad;
  guarantee not empty_bad;
noc
var
  accept_prefix, accept_word, input_ok: bool;
let
  (accept_prefix, accept_word, input_ok) = subset_monitor(symbol, true, (true -> false), true);
  bad = accept_prefix;
  empty_bad = false;
  --%MAIN ;
tel

